#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 027

# litellm-manager v1.0.0
# Ubuntu 24.04 LTS
# LiteLLM AI Gateway with staged Python venv releases and localhost-only systemd service.

readonly MANAGER_VERSION="1.0.1"
readonly MANAGER_PATH="/usr/local/bin/litellm-manager"
readonly LOCK_FILE="/run/lock/litellm-manager.lock"

log()  { printf '\n==> %s\n' "$*"; }
info() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die()  { printf '[ERROR] %s\n' "$*" >&2; exit 1; }
on_error() { local rc=$?; printf '[ERROR] Command failed at line %s (exit %s).\n' "${BASH_LINENO[0]:-?}" "$rc" >&2; exit "$rc"; }
trap on_error ERR
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run as root."; }
require_ubuntu() { [[ -r /etc/os-release ]] || die "Cannot read /etc/os-release."; . /etc/os-release; [[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 24.04 ]] || die "Ubuntu 24.04 LTS required."; }
lock() { install -d -m 0755 /run/lock; exec 9>"$LOCK_FILE"; flock -w 120 9 || die "Another litellm-manager operation is active."; }
self_install() { local s; s="$(readlink -f "${BASH_SOURCE[0]}")"; if [[ "$s" != "$MANAGER_PATH" ]]; then install -o root -g root -m 0755 "$s" "$MANAGER_PATH"; fi; }
begin() { require_root; require_ubuntu; lock; self_install; }

readonly USER="litellm"
readonly GROUP="litellm"
readonly ROOT="/opt/litellm"
readonly RELEASES="${ROOT}/releases"
readonly CURRENT="${ROOT}/current"
readonly PREVIOUS="${ROOT}/previous"
readonly CONF_DIR="/etc/litellm"
readonly CONFIG="${CONF_DIR}/config.yaml"
readonly ENV_FILE="${CONF_DIR}/litellm.env"
readonly SERVICE="litellm.service"
readonly UNIT="/etc/systemd/system/${SERVICE}"
readonly HOST="127.0.0.1"
readonly PORT="4000"

install_deps() { apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl python3 python3-venv python3-dev build-essential libffi-dev openssl util-linux; }
ensure_user() {
  if ! getent passwd "$USER" >/dev/null 2>&1; then
    if getent group "$GROUP" >/dev/null 2>&1; then
      useradd --system --gid "$GROUP" --home-dir /var/lib/litellm --create-home --shell /usr/sbin/nologin "$USER"
    else
      useradd --system --user-group --home-dir /var/lib/litellm --create-home --shell /usr/sbin/nologin "$USER"
    fi
  fi
  install -d -o root -g root -m 0755 "$ROOT" "$RELEASES" "$CONF_DIR"
}
ensure_config() {
  if [[ ! -f "$ENV_FILE" ]]; then local k; k="sk-$(openssl rand -hex 32)"; printf 'LITELLM_MASTER_KEY=%s\nUI_USERNAME=admin\n' "$k" >"$ENV_FILE"; fi
  chown root:root "$ENV_FILE"; chmod 0600 "$ENV_FILE"
  if [[ ! -f "$CONFIG" ]]; then cat >"$CONFIG" <<'EOF'
model_list: []
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
litellm_settings:
  drop_params: true
EOF
  fi
  chown root:"$GROUP" "$CONFIG"; chmod 0640 "$CONFIG"
}
stage() {
  local ver="${1:-latest}" dir old=""
  [[ "$ver" =~ ^[0-9A-Za-z._+-]+$ ]] || die "Unsafe version identifier."
  dir="$RELEASES/$(date -u +%Y%m%dT%H%M%SZ)-$ver"
  python3 -m venv "$dir"
  "$dir/bin/pip" install --disable-pip-version-check --upgrade pip setuptools wheel >/dev/null
  if [[ "$ver" == latest ]]; then "$dir/bin/pip" install --disable-pip-version-check 'litellm[proxy]'; else "$dir/bin/pip" install --disable-pip-version-check "litellm[proxy]==$ver"; fi
  "$dir/bin/litellm" --help >/dev/null
  chown -R root:root "$dir"
  if [[ -L "$CURRENT" ]]; then old="$(readlink -f "$CURRENT")"; fi
  ln -sfn "$dir" "$CURRENT"
  if [[ -n "$old" && "$old" != "$dir" ]]; then ln -sfn "$old" "$PREVIOUS"; fi
}
write_unit() { cat >"$UNIT" <<EOF
[Unit]
Description=LiteLLM AI Gateway (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${USER}
Group=${GROUP}
EnvironmentFile=${ENV_FILE}
WorkingDirectory=${ROOT}
ExecStart=${CURRENT}/bin/litellm --config ${CONFIG} --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=${CONFIG}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "$UNIT"; systemctl daemon-reload; }
install_ll() { begin; install_deps; ensure_user; ensure_config; stage "${1:-latest}"; write_unit; verify_ll; }
repair() { begin; install_deps; ensure_user; ensure_config; [[ -x "$CURRENT/bin/litellm" ]] || stage latest; write_unit; verify_ll; }
reinstall() { begin; install_deps; ensure_user; ensure_config; backup >/dev/null; stage "${1:-latest}"; write_unit; if systemctl is-active --quiet "$SERVICE"; then systemctl restart "$SERVICE"; fi; verify_ll; }
backup() { require_root; local out="${1:-/root/litellm-backup-$(date -u +%Y%m%dT%H%M%SZ).tar.gz}"; [[ "$out" == /* ]] || die "Backup path must be absolute."; tar -C / -czf "$out" etc/litellm 2>/dev/null || tar -czf "$out" --files-from /dev/null; chmod 0600 "$out"; echo "$out"; }
update() { begin; install_deps; backup >/dev/null; stage "${1:-latest}"; write_unit; if systemctl is-active --quiet "$SERVICE"; then systemctl restart "$SERVICE"; fi; verify_ll; }
rollback() { begin; [[ -L "$PREVIOUS" ]] || die "No previous release."; local old cur active=no; old="$(readlink -f "$PREVIOUS")"; cur="$(readlink -f "$CURRENT")"; systemctl is-active --quiet "$SERVICE" && active=yes || true; ln -sfn "$old" "$CURRENT"; ln -sfn "$cur" "$PREVIOUS"; if [[ "$active" == yes ]]; then systemctl restart "$SERVICE"; fi; verify_ll; }
check_update() { require_root; version; echo "Use 'litellm-manager update [VERSION]' for a staged release with rollback."; }
version() { echo "litellm-manager $MANAGER_VERSION"; if [[ -x "$CURRENT/bin/python" ]]; then "$CURRENT/bin/python" -c 'from importlib.metadata import version; print("litellm "+version("litellm"))' 2>/dev/null || true; fi; }
loopcheck() { local bad; bad="$(ss -H -lnt 2>/dev/null | awk '$4 ~ /:4000$/ {print $4}' | grep -Ev '^(127\.0\.0\.1:4000|\[::1\]:4000)$' || true)"; [[ -z "$bad" ]] || die "Unsafe LiteLLM listener: $bad"; }
config_check() { require_root; [[ -x "$CURRENT/bin/python" ]] || die "LiteLLM runtime missing."; "$CURRENT/bin/python" - "$CONFIG" <<'PYCFG'
import sys, yaml
p=yaml.safe_load(open(sys.argv[1], encoding='utf-8'))
assert isinstance(p, dict), 'top-level YAML must be a mapping'
assert isinstance(p.get('model_list', []), list), 'model_list must be a list'
print('config: OK')
PYCFG
}
verify_ll() { require_root; echo '=== LiteLLM verification ==='; getent passwd "$USER" >/dev/null || die "Service user missing."; [[ -x "$CURRENT/bin/litellm" && -f "$CONFIG" && -f "$ENV_FILE" && -f "$UNIT" ]] || die "Managed runtime/config missing."; [[ "$(stat -c %a "$ENV_FILE")" == 600 ]] || die "Secret file must be 0600."; config_check >/dev/null; loopcheck; if systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then systemctl is-active --quiet "$SERVICE" || die "LiteLLM is enabled but inactive."; curl -fsS http://127.0.0.1:4000/health/readiness >/dev/null || die "Readiness failed."; fi; echo 'LITELLM: VERIFIED'; }
start() { require_root; systemctl enable --now "$SERVICE"; sleep 4; systemctl is-active --quiet "$SERVICE" || die "LiteLLM service failed."; loopcheck; curl -fsS http://127.0.0.1:4000/health/readiness >/dev/null || die "Readiness failed."; }
stop() { require_root; systemctl stop "$SERVICE"; }
restart() { require_root; systemctl restart "$SERVICE"; sleep 4; systemctl is-active --quiet "$SERVICE" || die "LiteLLM service failed."; loopcheck; curl -fsS http://127.0.0.1:4000/health/readiness >/dev/null || die "Readiness failed."; }
status() { version; echo "Config: $CONFIG"; echo "Gateway: http://127.0.0.1:4000"; systemctl --no-pager --full status "$SERVICE" 2>/dev/null | sed -n '1,24p' || true; }
logs() { require_root; journalctl -u "$SERVICE" -n "${1:-200}" --no-pager; }
doctor() { status; echo; config_check 2>/dev/null || true; echo; ss -H -lntp | grep ':4000' || true; echo; logs 80 || true; }
key_status() { require_root; if grep -q '^LITELLM_MASTER_KEY=sk-' "$ENV_FILE" 2>/dev/null; then echo 'master key: configured'; else echo 'master key: missing'; return 1; fi; }
nginx_setup() { require_root; local domain="${1:-}" email="${2:-}"; [[ -n "$domain" && -n "$email" ]] || die "Usage: litellm-manager nginx-setup DOMAIN EMAIL"; [[ -x /usr/local/bin/nginx-manager ]] || die "nginx-manager is required."; /usr/local/bin/nginx-manager proxy-add-api "$domain" "http://127.0.0.1:4000"; /usr/local/bin/nginx-manager ssl-issue "$domain" "$email"; /usr/local/bin/nginx-manager site-verify "$domain"; }
help() { cat <<EOF
litellm-manager $MANAGER_VERSION
Lifecycle: install [VERSION] | repair | update [VERSION] | reinstall [VERSION] | rollback | check-update
Service: start | stop | restart | status | logs [N]
Inspection: verify | doctor | version | config-check | key-status
Public edge: nginx-setup DOMAIN EMAIL
Backup: backup [FILE]
Gateway: http://127.0.0.1:4000; Admin UI is provided by LiteLLM at /ui when supported/configured.
EOF
}
case "${1:-help}" in
  install) install_ll "${2:-latest}";; repair) repair;; update) update "${2:-latest}";; reinstall) reinstall "${2:-latest}";; rollback) rollback;; check-update) check_update;;
  start) start;; stop) stop;; restart) restart;; status) status;; logs) logs "${2:-200}";; verify) verify_ll;; doctor) doctor;; version) version;; config-check) config_check;; key-status) key_status;;
  nginx-setup) nginx_setup "${2:-}" "${3:-}";; backup) backup "${2:-}";; help|-h|--help) help;; *) help; exit 2;;
esac
