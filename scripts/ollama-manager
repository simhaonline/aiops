#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 027

# =============================================================================
# Ollama Cloud Manager - Ubuntu 24.04
# Manager version: 1.0.0
#
# Purpose:
#   Cloud-only Ollama operation. Model inference runs on Ollama Cloud.
#   This host keeps only the Ollama client / localhost compatibility proxy.
#
# Design:
#   - NO local model-performance tuning.
#   - NO GPU/ROCm/CUDA setup or probing.
#   - NO OLLAMA_MODELS / KEEP_ALIVE / NUM_PARALLEL / MAX_LOADED_MODELS tuning.
#   - NO forced local context length; Cloud models choose their Cloud context.
#   - Local proxy remains bound to 127.0.0.1:11434.
#   - Direct Cloud API is supported/preferred for programmatic workloads.
#   - API keys are never hard-coded and are stored root-only when configured.
#   - Legacy "aiops" supplementary membership in the ollama group is removed.
#   - ollama.service is explicitly pinned to User=ollama / Group=ollama.
#
# Main commands:
#   install | update | reinstall | delete | purge
#   start | stop | restart | status | verify | logs | version
#   signin | signout
#   set-key | clear-key | key-status
#   cloud-models
#   cloud-catalog
#   install-cloud [MODEL...]
#   sync-cloud
#   register-cloud MODEL
#   chat MODEL "PROMPT"
#   test MODEL
#   benchmark MODEL [RUNS]
#   cleanup-local-models
#   config | help
# =============================================================================

readonly MANAGER_VERSION="1.0.0"
readonly MANAGER_PATH="/usr/local/bin/ollama-manager"
readonly CONFIG_DIR="/etc/ollama-cloud"
readonly CONFIG_FILE="${CONFIG_DIR}/ollama.env"
readonly OVERRIDE_DIR="/etc/systemd/system/ollama.service.d"
readonly OVERRIDE_FILE="${OVERRIDE_DIR}/99-ollama-cloud-only.conf"
readonly LEGACY_OVERRIDE="${OVERRIDE_DIR}/10-simha-manager.conf"
readonly LEGACY_CONFIG="/etc/ollama/ollama.env"
readonly LEGACY_USER="aiops"
readonly OLLAMA_SERVICE_HOME="/usr/share/ollama"
readonly LOCAL_API="http://127.0.0.1:11434"
readonly CLOUD_HOST="https://ollama.com"
readonly CLOUD_API="${CLOUD_HOST}/api"
readonly LOG_LINES="${LOG_LINES:-200}"
readonly CONNECT_TIMEOUT="${OLLAMA_CONNECT_TIMEOUT:-10}"
readonly DEFAULT_BENCHMARK_RUNS="3"
readonly -a CLOUD_PROXY_MODELS=(
  "glm-5.2:cloud"
  "kimi-k2.6:cloud"
  "kimi-k2.7-code:cloud"
  "minimax-m3:cloud"
  "qwen3.5:cloud"
  "qwen3.5:397b-cloud"
  "deepseek-v4-pro:cloud"
  "deepseek-v4-pro:preview-cloud"
  "deepseek-v4-flash:0731-cloud"
  "deepseek-v4-flash:preview-cloud"
  "gpt-oss:20b-cloud"
  "gpt-oss:120b-cloud"
  "mistral-large-3:675b-cloud"
  "gemma4:cloud"
  "gemma4:31b-cloud"
  "nemotron-3-ultra:cloud"
  "nemotron-3-super:cloud"
  "nemotron-3-nano:30b-cloud"
)

log()  { printf '\n==> %s\n' "$*"; }
info() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die()  { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

on_error() {
  local rc=$?
  local line="${BASH_LINENO[0]:-unknown}"
  printf '[ERROR] Command failed at line %s (exit %s).\n' "$line" "$rc" >&2
  exit "$rc"
}
trap on_error ERR

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run as root: sudo $0 ${1:-status}"
}

require_ubuntu_2404() {
  [[ -r /etc/os-release ]] || die "Cannot read /etc/os-release"
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ "${ID:-}" == "ubuntu" ]] || die "Ubuntu is required."
  [[ "${VERSION_ID:-}" == "24.04" ]] || \
    die "Validated for Ubuntu 24.04. Found: ${PRETTY_NAME:-unknown}"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"
}

require_base_tools() {
  require_cmd curl
  require_cmd python3
}

self_install() {
  local src
  src="$(readlink -f "${BASH_SOURCE[0]}")"
  [[ "$src" == "$MANAGER_PATH" ]] && return 0
  install -o root -g root -m 0755 "$src" "$MANAGER_PATH"
  info "Manager installed: $MANAGER_PATH"
}

service_exists() {
  systemctl cat ollama.service >/dev/null 2>&1
}

ollama_user_exists() {
  id ollama >/dev/null 2>&1
}

ensure_ollama_service_user() {
  if ! ollama_user_exists; then
    if getent group ollama >/dev/null 2>&1; then
      useradd -r -s /bin/false -g ollama -m -d "$OLLAMA_SERVICE_HOME" ollama
    else
      useradd -r -s /bin/false -U -m -d "$OLLAMA_SERVICE_HOME" ollama
    fi
  fi

  install -d -o ollama -g ollama -m 0750 "$OLLAMA_SERVICE_HOME"
}

cleanup_legacy_user_mapping() {
  # Do not delete the legacy OS account. Only ensure it is not a supplementary
  # member of the Ollama service group.
  getent group ollama >/dev/null 2>&1 || return 0

  local members
  members="$(getent group ollama | awk -F: '{print $4}')"
  if [[ ",${members}," == *",${LEGACY_USER},"* ]]; then
    gpasswd -d "$LEGACY_USER" ollama >/dev/null 2>&1 || true
    info "Removed legacy user '$LEGACY_USER' from supplementary group 'ollama'."
  fi
}

backup_legacy_manager_config() {
  # Remove the old local-inference override so it cannot re-inject local-model
  # tuning. Preserve its config as a timestamped backup instead of destroying it.
  if [[ -f "$LEGACY_OVERRIDE" ]]; then
    rm -f "$LEGACY_OVERRIDE"
    info "Removed legacy local-inference systemd override: $LEGACY_OVERRIDE"
  fi

  if [[ -f "$LEGACY_CONFIG" ]]; then
    local stamp backup
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="${LEGACY_CONFIG}.pre-cloud-${stamp}.bak"
    mv "$LEGACY_CONFIG" "$backup"
    info "Migrated legacy local-inference config to: $backup"
  fi
}

write_cloud_config_if_missing() {
  require_root
  install -d -o root -g root -m 0700 "$CONFIG_DIR"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat >"$CONFIG_FILE" <<'EOF'
# Ollama Cloud Manager configuration
# Keep this file root-only because it may contain OLLAMA_API_KEY.
OLLAMA_CLOUD_HOST="https://ollama.com"
EOF
    chmod 0600 "$CONFIG_FILE"
    chown root:root "$CONFIG_FILE"
    info "Created Cloud configuration: $CONFIG_FILE"
  fi
}

load_cloud_config() {
  local inherited_host="${OLLAMA_CLOUD_HOST:-}"
  local inherited_key="${OLLAMA_API_KEY:-}"
  OLLAMA_CLOUD_HOST="$CLOUD_HOST"
  OLLAMA_API_KEY=""

  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi

  [[ -n "$inherited_host" ]] && OLLAMA_CLOUD_HOST="$inherited_host"
  [[ -n "$inherited_key" ]] && OLLAMA_API_KEY="$inherited_key"
  : "${OLLAMA_CLOUD_HOST:=$CLOUD_HOST}"
}

write_systemd_override() {
  require_root
  ensure_ollama_service_user
  backup_legacy_manager_config
  install -d -o root -g root -m 0755 "$OVERRIDE_DIR"

  cat >"$OVERRIDE_FILE" <<'EOF'
[Service]
# Cloud-only compatibility proxy. No local-model performance variables belong here.
User=ollama
Group=ollama
Environment="OLLAMA_HOST=127.0.0.1:11434"

# Explicitly discard legacy/local-inference settings inherited from older overrides.
UnsetEnvironment=OLLAMA_MODELS OLLAMA_KEEP_ALIVE OLLAMA_NUM_PARALLEL OLLAMA_MAX_LOADED_MODELS OLLAMA_CONTEXT_LENGTH OLLAMA_MAX_QUEUE OLLAMA_NO_CLOUD

# Keep the lightweight proxy resilient under concurrent API clients.
Restart=always
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=15s
LimitNOFILE=1048576
EOF

  chmod 0644 "$OVERRIDE_FILE"
  systemctl daemon-reload
  cleanup_legacy_user_mapping

  if service_exists; then
    local effective_user effective_group
    effective_user="$(systemctl show ollama.service -p User --value)"
    effective_group="$(systemctl show ollama.service -p Group --value)"
    [[ "$effective_user" == "ollama" && "$effective_group" == "ollama" ]] || \
      die "Effective ollama.service identity is ${effective_user:-unset}:${effective_group:-unset}; expected ollama:ollama. Check later-sorting systemd drop-ins."
  fi
}

official_install() {
  require_root
  require_ubuntu_2404
  require_base_tools

  log "Running Ollama's official Linux installer"

  local tmp
  tmp="$(mktemp /tmp/ollama-install.XXXXXX.sh)"
  chmod 0700 "$tmp"

  if ! curl -fL --proto '=https' --tlsv1.2 \
      --connect-timeout "$CONNECT_TIMEOUT" \
      --retry 3 --retry-delay 1 --retry-connrefused \
      https://ollama.com/install.sh -o "$tmp"; then
    rm -f "$tmp"
    die "Could not download Ollama's official installer."
  fi

  if [[ -n "${OLLAMA_VERSION:-}" ]]; then
    info "Installing requested Ollama version: $OLLAMA_VERSION"
    OLLAMA_VERSION="$OLLAMA_VERSION" sh "$tmp"
  else
    sh "$tmp"
  fi

  rm -f "$tmp"
}

wait_for_local_api() {
  local i
  for i in $(seq 1 30); do
    if curl -fsS --connect-timeout 2 --max-time 3 "$LOCAL_API/api/tags" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

restart_service() {
  require_root
  service_exists || die "ollama.service is not installed."
  write_systemd_override
  systemctl enable ollama.service >/dev/null
  systemctl restart ollama.service

  if ! wait_for_local_api; then
    systemctl --no-pager --full status ollama.service || true
    journalctl -u ollama.service -n 100 --no-pager || true
    die "Ollama localhost compatibility API did not become healthy."
  fi
}

install_ollama() {
  require_root
  require_ubuntu_2404
  require_base_tools

  log "Installing Ollama for Cloud-only operation"
  official_install
  write_cloud_config_if_missing
  write_systemd_override

  systemctl enable --now ollama.service >/dev/null
  systemctl restart ollama.service
  wait_for_local_api || die "Ollama installed, but localhost API verification failed."

  self_install

  log "Installation complete"
  ollama --version || true
  echo "Local compatibility API: $LOCAL_API"
  echo "Direct Cloud API:        $CLOUD_API"
  echo
  echo "No local models are installed or started by this manager."
  echo "Next:"
  echo "  sudo ollama-manager set-key        # recommended for direct Cloud API"
  echo "  ollama signin                      # optional for Ollama CLI/local proxy"
  echo "  sudo ollama-manager install-cloud  # select Cloud-only proxy models"
  echo "  sudo ollama-manager verify"

  if [[ -t 0 && -t 1 ]]; then
    printf '\n'
    install_cloud_models
  fi
}

update_ollama() {
  require_root
  require_ubuntu_2404
  require_base_tools

  log "Updating Ollama"
  official_install
  write_cloud_config_if_missing
  write_systemd_override
  systemctl enable --now ollama.service >/dev/null
  systemctl restart ollama.service
  wait_for_local_api || die "Update completed, but localhost API verification failed."
  self_install
  ollama --version
  info "Update complete."
}

reinstall_ollama() {
  require_root
  require_ubuntu_2404
  require_base_tools

  log "Reinstalling Ollama runtime"
  systemctl stop ollama.service 2>/dev/null || true
  official_install
  write_cloud_config_if_missing
  write_systemd_override
  systemctl enable --now ollama.service >/dev/null
  systemctl restart ollama.service
  wait_for_local_api || die "Reinstall completed, but localhost API verification failed."
  self_install
  info "Runtime reinstalled; Cloud configuration preserved."
}

remove_runtime_files() {
  systemctl stop ollama.service 2>/dev/null || true
  systemctl disable ollama.service 2>/dev/null || true

  rm -f "$OVERRIDE_FILE" "$LEGACY_OVERRIDE"
  rm -f /etc/systemd/system/ollama.service

  local binary=""
  binary="$(command -v ollama 2>/dev/null || true)"

  rm -rf /usr/lib/ollama /usr/local/lib/ollama /lib/ollama

  case "$binary" in
    /usr/bin/ollama|/usr/local/bin/ollama|/bin/ollama) rm -f "$binary" ;;
    "") ;;
    *) warn "Unexpected Ollama binary path was not removed automatically: $binary" ;;
  esac

  rm -f /usr/bin/ollama /usr/local/bin/ollama /bin/ollama
  systemctl daemon-reload
  systemctl reset-failed ollama.service 2>/dev/null || true
}

delete_ollama() {
  require_root
  log "Removing Ollama runtime"
  warn "Cloud manager config is preserved: $CONFIG_FILE"
  warn "Service home/local model cache is preserved: $OLLAMA_SERVICE_HOME"
  remove_runtime_files
  info "Ollama runtime removed. Manager remains at $MANAGER_PATH"
}

purge_ollama() {
  require_root

  cat <<EOF

DESTRUCTIVE OPERATION
This removes:
  - Ollama runtime/service
  - $CONFIG_DIR (including stored Cloud API key)
  - $OLLAMA_SERVICE_HOME (including any local model/cache data)
  - ollama service user/group

The unrelated '$LEGACY_USER' OS account is NOT deleted.
EOF

  local answer=""
  read -r -p "Type PURGE-OLLAMA-CLOUD to continue: " answer
  [[ "$answer" == "PURGE-OLLAMA-CLOUD" ]] || die "Purge cancelled."

  remove_runtime_files
  rm -rf "$CONFIG_DIR" "$OLLAMA_SERVICE_HOME"

  if ollama_user_exists; then
    userdel ollama 2>/dev/null || true
  fi
  if getent group ollama >/dev/null 2>&1; then
    groupdel ollama 2>/dev/null || true
  fi

  info "Ollama runtime, Cloud config, and Ollama service data removed."
}

start_ollama() {
  require_root
  service_exists || die "ollama.service is not installed."
  systemctl start ollama.service
  wait_for_local_api || die "Service started but localhost API is unavailable."
  info "Ollama compatibility proxy started."
}

stop_ollama() {
  require_root
  service_exists || die "ollama.service is not installed."
  systemctl stop ollama.service
  info "Ollama compatibility proxy stopped."
}

restart_ollama() {
  restart_service
  info "Ollama compatibility proxy restarted."
}

set_key() {
  require_root
  write_cloud_config_if_missing

  local key=""
  printf 'Enter Ollama Cloud API key (input hidden): ' >&2
  IFS= read -r -s key
  printf '\n' >&2
  [[ -n "$key" ]] || die "API key cannot be empty."
  [[ "$key" != *$'\n'* && "$key" != *$'\r'* ]] || die "Invalid API key."

  python3 - "$CONFIG_FILE" 3<<<"$key" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
with open(3, 'r', encoding='utf-8', closefd=False) as secret_fd:
    key = secret_fd.read()
if key.endswith('\n'):
    key = key[:-1]
text = path.read_text(encoding='utf-8') if path.exists() else ''
line = 'OLLAMA_API_KEY="' + key.replace('\\', '\\\\').replace('"', '\\"') + '"'
pattern = re.compile(r'^OLLAMA_API_KEY=.*$', re.MULTILINE)
if pattern.search(text):
    text = pattern.sub(line, text)
else:
    if text and not text.endswith('\n'):
        text += '\n'
    text += line + '\n'
path.write_text(text, encoding='utf-8')
PY

  chmod 0600 "$CONFIG_FILE"
  chown root:root "$CONFIG_FILE"
  unset key
  info "Ollama Cloud API key stored root-only in $CONFIG_FILE"
}

clear_key() {
  require_root
  [[ -f "$CONFIG_FILE" ]] || return 0

  python3 - "$CONFIG_FILE" <<'PY'
from pathlib import Path
import re
import sys
p = Path(sys.argv[1])
text = p.read_text(encoding='utf-8')
text = re.sub(r'^OLLAMA_API_KEY=.*\n?', '', text, flags=re.MULTILINE)
p.write_text(text, encoding='utf-8')
PY

  chmod 0600 "$CONFIG_FILE"
  info "Stored Ollama Cloud API key removed."
}

key_status() {
  load_cloud_config
  if [[ -n "${OLLAMA_API_KEY:-}" ]]; then
    echo "Cloud API key: CONFIGURED"
  else
    echo "Cloud API key: NOT CONFIGURED"
  fi
}

make_auth_header_file() {
  load_cloud_config
  [[ -n "${OLLAMA_API_KEY:-}" ]] || \
    die "No Cloud API key configured. Run: sudo ollama-manager set-key"

  local file
  file="$(mktemp /tmp/ollama-auth.XXXXXX)"
  chmod 0600 "$file"
  printf 'Authorization: Bearer %s\n' "$OLLAMA_API_KEY" >"$file"
  printf '%s' "$file"
}

curl_http_args() {
  # Print one argument per line; caller consumes into an array.
  printf '%s\n' \
    '--fail-with-body' \
    '--silent' \
    '--show-error' \
    '--location' \
    '--compressed' \
    '--connect-timeout' "$CONNECT_TIMEOUT" \
    '--retry' '2' \
    '--retry-delay' '1' \
    '--retry-connrefused'

  if [[ "$(curl -V 2>/dev/null)" == *HTTP2* ]]; then
    printf '%s\n' '--http2'
  fi
}

cloud_models() {
  require_base_tools
  load_cloud_config

  local -a args=()
  mapfile -t args < <(curl_http_args)

  local header_file=""
  if [[ -n "${OLLAMA_API_KEY:-}" ]]; then
    header_file="$(make_auth_header_file)"
    trap 'rm -f "$header_file"' EXIT
    curl "${args[@]}" -H @"$header_file" "${OLLAMA_CLOUD_HOST%/}/api/tags"
    rm -f "$header_file"
    trap - EXIT
  else
    curl "${args[@]}" "${OLLAMA_CLOUD_HOST%/}/api/tags"
  fi
  printf '\n'
}

cloud_catalog() {
  local index
  echo "Supported Ollama Cloud proxy models:"
  for index in "${!CLOUD_PROXY_MODELS[@]}"; do
    printf '  %2d) %s\n' "$((index + 1))" "${CLOUD_PROXY_MODELS[$index]}"
  done
}

is_cloud_proxy_model() {
  local requested="$1" model
  for model in "${CLOUD_PROXY_MODELS[@]}"; do
    [[ "$requested" == "$model" ]] && return 0
  done
  return 1
}

pull_cloud_model() {
  local model="$1"
  is_cloud_proxy_model "$model" \
    || die "Refusing model outside the approved Cloud catalog: $model"

  log "Registering Cloud model with the localhost proxy: $model"
  ollama pull "$model"
  info "Cloud model registered: $model (weights remain on Ollama Cloud)."
}

install_cloud_models() {
  local -a requested=()
  local selection="" item index

  require_cmd ollama
  service_exists || die "ollama.service is not installed."
  systemctl is-active --quiet ollama.service || die "ollama.service is not active."

  if (($#)); then
    requested=("$@")
  else
    cloud_catalog
    printf '\nChoose model numbers/names separated by commas, "all", or Enter to skip: '
    IFS= read -r selection
    [[ -n "$selection" ]] || { info "Cloud model installation skipped."; return 0; }

    if [[ "$selection" == all ]]; then
      requested=("${CLOUD_PROXY_MODELS[@]}")
    else
      local -a choices=()
      IFS=',' read -r -a choices <<<"$selection"
      for item in "${choices[@]}"; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        if [[ "$item" =~ ^[0-9]+$ ]]; then
          index=$((item - 1))
          ((index >= 0 && index < ${#CLOUD_PROXY_MODELS[@]})) \
            || die "Cloud model selection is out of range: $item"
          requested+=("${CLOUD_PROXY_MODELS[$index]}")
        else
          requested+=("$item")
        fi
      done
    fi
  fi

  for item in "${requested[@]}"; do
    pull_cloud_model "$item"
  done
}

sync_cloud_models() {
  install_cloud_models "${CLOUD_PROXY_MODELS[@]}"
  info "Approved Ollama Cloud proxy catalog synchronized."
}

signin_ollama() {
  require_cmd ollama
  ollama signin
}

signout_ollama() {
  require_cmd ollama
  ollama signout
}

register_cloud_model() {
  local model="${1:-}"
  [[ -n "$model" ]] || die "Usage: $0 register-cloud MODEL"
  require_cmd ollama
  service_exists || die "ollama.service is not installed."
  systemctl is-active --quiet ollama.service || die "ollama.service is not active."

  pull_cloud_model "$model"
}

build_chat_payload() {
  local model="$1"
  local prompt="$2"
  local stream="$3"

  python3 - "$model" "$prompt" "$stream" <<'PY'
import json
import sys
model, prompt, stream = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.dumps({
    "model": model,
    "messages": [{"role": "user", "content": prompt}],
    "stream": stream.lower() == "true",
}, separators=(",", ":")))
PY
}

direct_chat() {
  local model="${1:-}"
  shift || true
  local prompt=""
  if (( $# > 0 )); then
    printf -v prompt '%s ' "$@"
    prompt="${prompt% }"
  fi
  [[ -n "$model" && -n "$prompt" ]] || die "Usage: $0 chat MODEL \"PROMPT\""
  require_base_tools

  local header_file
  header_file="$(make_auth_header_file)"
  trap 'rm -f "$header_file"' EXIT

  local -a args=()
  mapfile -t args < <(curl_http_args)

  build_chat_payload "$model" "$prompt" true | \
    curl "${args[@]}" --no-buffer -N \
      -H @"$header_file" \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${OLLAMA_CLOUD_HOST%/}/api/chat" | \
    python3 -u -c 'import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    obj = json.loads(line)
    msg = (obj.get("message") or {}).get("content")
    if msg:
        print(msg, end="", flush=True)
'
  printf '\n'

  rm -f "$header_file"
  trap - EXIT
}

test_cloud() {
  local model="${1:-}"
  [[ -n "$model" ]] || die "Usage: $0 test MODEL"
  require_base_tools

  local header_file tmp
  header_file="$(make_auth_header_file)"
  tmp="$(mktemp /tmp/ollama-test.XXXXXX.json)"
  trap 'rm -f "$header_file" "$tmp"' EXIT

  local -a args=()
  mapfile -t args < <(curl_http_args)

  local http_stats
  http_stats="$({ build_chat_payload "$model" "Reply with exactly: OK" false | \
    curl "${args[@]}" \
      -H @"$header_file" \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      -o "$tmp" \
      -w 'dns=%{time_namelookup}s connect=%{time_connect}s tls=%{time_appconnect}s ttfb=%{time_starttransfer}s total=%{time_total}s' \
      "${OLLAMA_CLOUD_HOST%/}/api/chat"; } 2>&1)" || {
        cat "$tmp" >&2 2>/dev/null || true
        die "Cloud inference test failed: $http_stats"
      }

  python3 - "$tmp" "$http_stats" <<'PY'
import json
import sys
from pathlib import Path

p = Path(sys.argv[1])
stats = sys.argv[2]
data = json.loads(p.read_text(encoding='utf-8'))
message = ((data.get('message') or {}).get('content') or '').strip()
print('Cloud inference: OK')
print(f'Response: {message[:160]}')
print(f'Network: {stats}')

for key in ('total_duration', 'load_duration', 'prompt_eval_count', 'prompt_eval_duration', 'eval_count', 'eval_duration'):
    if key in data:
        print(f'{key}: {data[key]}')

count = data.get('eval_count')
dur = data.get('eval_duration')
if isinstance(count, (int, float)) and isinstance(dur, (int, float)) and dur > 0:
    print(f'output_tokens_per_second: {count / (dur / 1_000_000_000):.2f}')
PY

  rm -f "$header_file" "$tmp"
  trap - EXIT
}

benchmark_cloud() {
  local model="${1:-}"
  local runs="${2:-$DEFAULT_BENCHMARK_RUNS}"
  [[ -n "$model" ]] || die "Usage: $0 benchmark MODEL [RUNS]"
  [[ "$runs" =~ ^[1-9][0-9]*$ ]] || die "RUNS must be a positive integer."
  (( runs <= 20 )) || die "RUNS is capped at 20 to avoid accidental Cloud usage."
  require_base_tools

  local header_file
  header_file="$(make_auth_header_file)"
  trap 'rm -f "$header_file"' EXIT

  local -a args=()
  mapfile -t args < <(curl_http_args)

  local results
  results="$(mktemp /tmp/ollama-benchmark.XXXXXX.tsv)"
  trap 'rm -f "$header_file" "$results"' EXIT

  printf 'run\tttfb_s\ttotal_s\teval_count\teval_duration_ns\ttokens_per_s\n' >"$results"

  local i tmp metrics
  for i in $(seq 1 "$runs"); do
    tmp="$(mktemp /tmp/ollama-bench-response.XXXXXX.json)"

    metrics="$({ build_chat_payload "$model" "In one short sentence, define latency." true | \
      curl "${args[@]}" \
        -H @"$header_file" \
        -H 'Content-Type: application/json' \
        --data-binary @- \
        -o "$tmp" \
        -w '%{time_starttransfer}\t%{time_total}' \
        "${OLLAMA_CLOUD_HOST%/}/api/chat"; } 2>&1)" || {
          cat "$tmp" >&2 2>/dev/null || true
          rm -f "$tmp"
          die "Benchmark run $i failed: $metrics"
        }

    python3 - "$i" "$metrics" "$tmp" >>"$results" <<'PY'
import json
import sys
from pathlib import Path

run = sys.argv[1]
ttfb, total = sys.argv[2].split('\t')
lines = [line for line in Path(sys.argv[3]).read_text(encoding='utf-8').splitlines() if line.strip()]
objects = [json.loads(line) for line in lines]
data = next((obj for obj in reversed(objects) if obj.get('done') is True), objects[-1] if objects else {})
count = data.get('eval_count') or 0
dur = data.get('eval_duration') or 0
tps = (count / (dur / 1_000_000_000)) if count and dur else 0
print(f'{run}\t{ttfb}\t{total}\t{count}\t{dur}\t{tps:.2f}')
PY

    rm -f "$tmp"
    printf 'Run %s/%s complete\n' "$i" "$runs" >&2
  done

  python3 - "$results" <<'PY'
import csv
import statistics
import sys

with open(sys.argv[1], newline='', encoding='utf-8') as f:
    rows = list(csv.DictReader(f, delimiter='\t'))

ttfb = [float(r['ttfb_s']) for r in rows]
total = [float(r['total_s']) for r in rows]
tps = [float(r['tokens_per_s']) for r in rows if float(r['tokens_per_s']) > 0]

print('\n=== Ollama Cloud benchmark ===')
print(f'runs: {len(rows)}')
print(f'ttfb_avg_s: {statistics.mean(ttfb):.3f}')
print(f'ttfb_best_s: {min(ttfb):.3f}')
print(f'total_avg_s: {statistics.mean(total):.3f}')
print(f'total_best_s: {min(total):.3f}')
if tps:
    print(f'output_tokens_per_second_avg: {statistics.mean(tps):.2f}')
    print(f'output_tokens_per_second_best: {max(tps):.2f}')
PY

  rm -f "$header_file" "$results"
  trap - EXIT
}

cleanup_local_models() {
  require_root

  local candidates=(
    "/opt/ollama/models"
    "$OLLAMA_SERVICE_HOME/.ollama/models"
  )

  local found=0 path
  for path in "${candidates[@]}"; do
    [[ -e "$path" ]] || continue
    found=1
    du -sh "$path" 2>/dev/null || true
  done

  if (( found == 0 )); then
    info "No standard local model directories found."
    return 0
  fi

  local answer=""
  read -r -p "Type DELETE-LOCAL-MODELS to remove these local model files: " answer
  [[ "$answer" == "DELETE-LOCAL-MODELS" ]] || die "Cleanup cancelled."

  for path in "${candidates[@]}"; do
    case "$path" in
      /opt/ollama/models|/usr/share/ollama/.ollama/models) rm -rf "$path" ;;
      *) die "Refusing unexpected local model path: $path" ;;
    esac
  done

  info "Local model files removed. Cloud operation is unaffected."
}

show_config() {
  echo "=== Ollama Cloud Manager ==="
  echo "Manager:          $MANAGER_PATH"
  echo "Cloud config:     $CONFIG_FILE"
  echo "Systemd override: $OVERRIDE_FILE"
  echo "Local API:        $LOCAL_API"
  echo "Cloud API:        $CLOUD_API"
  echo

  load_cloud_config
  echo "Cloud host:       $OLLAMA_CLOUD_HOST"
  if [[ -n "${OLLAMA_API_KEY:-}" ]]; then
    echo "Cloud API key:    CONFIGURED (hidden)"
  else
    echo "Cloud API key:    NOT CONFIGURED"
  fi

  echo
  echo "No local inference tuning is managed."
}

cloud_latency_probe() {
  local -a args=()
  mapfile -t args < <(curl_http_args)

  curl "${args[@]}" -o /dev/null \
    -w 'DNS %{time_namelookup}s | TCP %{time_connect}s | TLS %{time_appconnect}s | TTFB %{time_starttransfer}s | Total %{time_total}s\n' \
    "$CLOUD_API/tags" 2>/dev/null || echo "Cloud reachability: FAILED"
}

status_ollama() {
  echo "=== Binary ==="
  if command -v ollama >/dev/null 2>&1; then
    echo "Path:    $(command -v ollama)"
    echo "Version: $(ollama --version 2>/dev/null || true)"
  else
    echo "Ollama binary: NOT INSTALLED"
  fi

  echo
  echo "=== Service ==="
  if service_exists; then
    systemctl --no-pager --full status ollama.service | sed -n '1,16p' || true
    echo
    systemctl show ollama.service -p User -p Group -p MainPID -p MemoryCurrent -p CPUUsageNSec --no-pager || true
  else
    echo "ollama.service: NOT INSTALLED"
  fi

  echo
  echo "=== Local compatibility API ==="
  if curl -fsS --connect-timeout 2 --max-time 3 "$LOCAL_API/api/tags" >/dev/null 2>&1; then
    echo "Health: OK ($LOCAL_API)"
  else
    echo "Health: NOT AVAILABLE"
  fi

  echo
  echo "=== Cloud ==="
  key_status
  cloud_latency_probe

  echo
  echo "=== Ollama group mapping ==="
  if getent group ollama >/dev/null 2>&1; then
    getent group ollama
    local members
    members="$(getent group ollama | awk -F: '{print $4}')"
    if [[ ",${members}," == *",${LEGACY_USER},"* ]]; then
      echo "Legacy mapping: PRESENT (run install/update/restart to clean it)"
    else
      echo "Legacy mapping: CLEAN"
    fi
  else
    echo "ollama group: NOT PRESENT"
  fi

  echo
  echo "GPU status: NOT USED / NOT PROBED (Cloud-only inference)"
}

verify_ollama() {
  require_root
  require_base_tools
  require_cmd ollama
  service_exists || die "ollama.service is missing."
  systemctl is-active --quiet ollama.service || die "ollama.service is not active."
  wait_for_local_api || die "Local compatibility API is not responding."

  local svc_user svc_group
  svc_user="$(systemctl show ollama.service -p User --value)"
  svc_group="$(systemctl show ollama.service -p Group --value)"
  [[ "$svc_user" == "ollama" ]] || die "ollama.service User is '$svc_user', expected 'ollama'."
  [[ "$svc_group" == "ollama" ]] || die "ollama.service Group is '$svc_group', expected 'ollama'."

  local members=""
  members="$(getent group ollama | awk -F: '{print $4}')"
  [[ ",${members}," != *",${LEGACY_USER},"* ]] || \
    die "Legacy user '$LEGACY_USER' is still mapped to group 'ollama'."

  curl -fsS --compressed --connect-timeout "$CONNECT_TIMEOUT" --max-time 20 \
    "$CLOUD_API/tags" >/dev/null || die "Cannot reach Ollama Cloud API."

  echo "OLLAMA CLOUD: VERIFIED"
  echo "Version:       $(ollama --version 2>/dev/null || true)"
  echo "Service user:  $svc_user:$svc_group"
  echo "Local API:     $LOCAL_API"
  echo "Cloud API:     $CLOUD_API"
  key_status
  echo "Local weights: not required"
  echo "GPU:           not used"
}

logs_ollama() {
  require_root
  journalctl -u ollama.service -n "$LOG_LINES" --no-pager
}

show_manager_version() {
  echo "ollama-manager $MANAGER_VERSION"
  command -v ollama >/dev/null 2>&1 && ollama --version 2>/dev/null || true
}

show_version() {
  require_cmd ollama
  ollama --version
}

help_text() {
  cat <<EOF
Ollama Cloud Manager v$MANAGER_VERSION (Ubuntu 24.04)

Usage:
  sudo ollama-manager <command>

Lifecycle:
  install                   Install/update official Ollama + Cloud-only service config
  update                    Re-run official installer and re-apply Cloud-only config
  reinstall                 Reinstall runtime while preserving Cloud config/key
  delete                    Remove runtime; preserve Cloud config and service data
  purge                     Remove runtime + Cloud config/key + Ollama service data
  start|stop|restart        Manage localhost compatibility proxy
  status                    Service, Cloud reachability, identity and latency status
  verify                    Verify Cloud-only installation and service isolation
  logs                      Show recent ollama.service logs
  manager-version           Show manager + Ollama version
  version                   Show Ollama version

Authentication:
  signin                    Ollama account sign-in for CLI/local-proxy Cloud models
  signout                   Sign out Ollama CLI/local proxy
  set-key                   Securely store API key for direct Cloud API access
  clear-key                 Remove stored direct Cloud API key
  key-status                Show whether a Cloud API key is configured

Cloud operations:
  cloud-models              List models exposed by Ollama Cloud API
  cloud-catalog             List approved Cloud-only localhost proxy models
  install-cloud [MODEL...]  Select or install one or more approved Cloud models
  sync-cloud                Re-register every approved Cloud model
  register-cloud MODEL      Register one approved Cloud model (compatibility alias)
  chat MODEL "PROMPT"       Stream directly from https://ollama.com/api
  test MODEL                Direct Cloud inference + network/performance metrics
  benchmark MODEL [RUNS]    Compare Cloud TTFB/total time/token throughput (max 20)

Cleanup:
  cleanup-local-models      Delete standard local model-weight directories only
  config                    Show manager config (API key is never printed)

Examples:
  sudo ./ollama-manager install
  sudo ollama-manager set-key
  sudo ollama-manager cloud-models
  sudo ollama-manager cloud-catalog
  sudo ollama-manager install-cloud glm-5.2:cloud kimi-k2.7-code:cloud
  sudo ollama-manager test kimi-k2.6
  sudo ollama-manager benchmark kimi-k2.6 3
  sudo ollama-manager chat kimi-k2.6 "Explain this error briefly"

  # Direct API model names and localhost-proxy model names can differ.
  # Use the name returned by 'cloud-models' for direct API calls.
  # For applications that require localhost:11434:
  ollama signin
  sudo ollama-manager register-cloud kimi-k2.6:cloud

Performance policy:
  - inference is remote on Ollama Cloud, so local GPU/VRAM/model-cache tuning is removed.
  - direct Cloud API is preferred when localhost compatibility is not required.
  - streaming uses unbuffered output for lower perceived latency.
  - Cloud latency diagnostics expose DNS/TCP/TLS/TTFB/total time.
  - no global kernel/sysctl changes are made; they can destabilize unrelated services.

Security policy:
  - localhost proxy is fixed to 127.0.0.1:11434.
  - stored API key is root-only (0600) and hidden from process arguments.
  - ollama.service is pinned to User=ollama / Group=ollama.
  - legacy '$LEGACY_USER' supplementary membership in 'ollama' is removed.
  - the unrelated '$LEGACY_USER' OS account is never deleted by this manager.
EOF
}

main() {
  local command="${1:-help}"

  case "$command" in
    install) install_ollama ;;
    update) update_ollama ;;
    reinstall) reinstall_ollama ;;
    delete|remove|uninstall) delete_ollama ;;
    purge) purge_ollama ;;
    start) start_ollama ;;
    stop) stop_ollama ;;
    restart) restart_ollama ;;
    status) status_ollama ;;
    verify) verify_ollama ;;
    logs) logs_ollama ;;
    config) show_config ;;
    signin) signin_ollama ;;
    signout) signout_ollama ;;
    set-key) set_key ;;
    clear-key) clear_key ;;
    key-status) key_status ;;
    cloud-models) cloud_models ;;
    cloud-catalog) cloud_catalog ;;
    install-cloud) shift; install_cloud_models "$@" ;;
    sync-cloud) sync_cloud_models ;;
    register-cloud) shift; register_cloud_model "${1:-}" ;;
    chat) shift; direct_chat "${1:-}" "${@:2}" ;;
    test) shift; test_cloud "${1:-}" ;;
    benchmark) shift; benchmark_cloud "${1:-}" "${2:-$DEFAULT_BENCHMARK_RUNS}" ;;
    cleanup-local-models) cleanup_local_models ;;
    manager-version) show_manager_version ;;
    version) show_version ;;
    help|-h|--help) help_text ;;
    *)
      help_text
      echo
      die "Unknown command: $command"
      ;;
  esac
}

main "$@"
