#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly MANAGER_VERSION="1.0.0"
readonly MANAGED_DIR=".aiops"
readonly COMPOSE_REL="${MANAGED_DIR}/compose.yaml"
readonly ENV_REL="${MANAGED_DIR}/project.env"
readonly DOCKERFILE_REL="${MANAGED_DIR}/container/Dockerfile"
readonly FEATURE_REL="${MANAGED_DIR}/features"
readonly SECRET_REL="${MANAGED_DIR}/secrets"
readonly AI_REL="${MANAGED_DIR}/ai"
readonly NGINX_MANAGER="${AIOPS_NGINX_MANAGER:-/usr/local/bin/nginx-manager}"

die(){ printf '[ERROR] %s\n' "$*" >&2; exit 1; }
info(){ printf '[INFO] %s\n' "$*"; }

require_command(){ command -v "$1" >/dev/null 2>&1 || die "Required command missing: $1"; }

canonical_existing_dir(){
  [[ -d "$1" ]] || die "Directory does not exist: $1"
  (cd -- "$1" && pwd -P)
}

project_root(){
  local start="${1:-$PWD}" current
  current="$(canonical_existing_dir "$start")"
  while [[ "$current" != / ]]; do
    if [[ -f "$current/$ENV_REL" && -f "$current/$COMPOSE_REL" ]]; then
      printf '%s\n' "$current"
      return 0
    fi
    current="$(dirname "$current")"
  done
  die "No managed project found. Run 'project-manager init PATH'."
}

validate_name(){
  [[ "$1" =~ ^[a-z][a-z0-9_-]{0,47}$ ]] || \
    die "Project name must start with a lowercase letter and contain only lowercase letters, numbers, _ or -."
}

default_name(){
  local value
  value="$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-')"
  value="${value#-}"; value="${value%-}"
  [[ "$value" =~ ^[a-z] ]] || value="project-${value:-dev}"
  printf '%.48s\n' "$value"
}

compose(){
  local root="$1" feature_file args=(); shift
  require_command docker
  args+=(--project-directory "$root" --env-file "$root/$ENV_REL" -f "$root/$COMPOSE_REL")
  if [[ -f "$root/$SECRET_REL/code-server.env" ]]; then
    args=(--project-directory "$root" --env-file "$root/$ENV_REL" --env-file "$root/$SECRET_REL/code-server.env" -f "$root/$COMPOSE_REL")
  fi
  if [[ -d "$root/$FEATURE_REL" ]]; then
    while IFS= read -r feature_file; do args+=(-f "$feature_file"); done \
      < <(find "$root/$FEATURE_REL" -maxdepth 1 -type f -name '*.yaml' | sort)
  fi
  docker compose "${args[@]}" "$@"
}

allocate_code_server_port(){
  local root="$1" parent candidate used
  parent="$(dirname "$root")"
  for candidate in $(seq 18080 18999); do
    used="$(find "$parent" -mindepth 2 -maxdepth 3 -type f -path '*/.aiops/project.env' -exec \
      awk -F= '$1=="AIOPS_CODE_SERVER_PORT" {print $2}' {} + 2>/dev/null || true)"
    grep -Fxq "$candidate" <<<"$used" && continue
    if command -v ss >/dev/null 2>&1 && \
      ss -H -lnt 2>/dev/null | awk -v suffix=":${candidate}" '$4 ~ suffix"$" {found=1} END {exit !found}'; then
      continue
    fi
    printf '%s\n' "$candidate"
    return 0
  done
  die "No free project UI port is available in 18080-18999."
}

allocate_collection_port(){
  local root="$1" parent candidate used
  parent="$(dirname "$root")"
  for candidate in $(seq 19080 19999); do
    used="$(find "$parent" -mindepth 2 -maxdepth 3 -type f -path '*/.aiops/project.env' -exec \
      awk -F= '$1=="AIOPS_COLLECTION_PORT" {print $2}' {} + 2>/dev/null || true)"
    grep -Fxq "$candidate" <<<"$used" && continue
    if command -v ss >/dev/null 2>&1 && \
      ss -H -lnt 2>/dev/null | awk -v suffix=":${candidate}" '$4 ~ suffix"$" {found=1} END {exit !found}'; then
      continue
    fi
    printf '%s\n' "$candidate"; return 0
  done
  die "No free collection UI port is available in 19080-19999."
}

write_templates(){
  local root="$1" name="$2" uid gid code_server_port collection_port
  uid="${AIOPS_PROJECT_UID:-$(id -u)}"; gid="${AIOPS_PROJECT_GID:-$(id -g)}"
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] || die "Project UID/GID must be numeric."
  if [[ "$uid" == 0 ]]; then uid=10000; fi
  if [[ "$gid" == 0 ]]; then gid=10000; fi
  code_server_port="$(allocate_code_server_port "$root")"
  collection_port="$(allocate_collection_port "$root")"
  install -d -m 0700 \
    "$root/$MANAGED_DIR/container" \
    "$root/$MANAGED_DIR/home/.codex/skills" \
    "$root/$MANAGED_DIR/home/.codex/plugins" \
    "$root/$MANAGED_DIR/home/.config" \
    "$root/$AI_REL" \
    "$root/$FEATURE_REL" \
    "$root/$SECRET_REL" \
    "$root/$MANAGED_DIR/backups"

  cat >"$root/$ENV_REL" <<EOF
AIOPS_PROJECT_NAME=$name
AIOPS_UID=$uid
AIOPS_GID=$gid
AIOPS_BASE_IMAGE=ubuntu:24.04
AIOPS_PACKAGES=ca-certificates curl git jq build-essential python3 python3-venv python3-pip nodejs npm golang-go
AIOPS_CODE_SERVER_PORT=$code_server_port
AIOPS_COLLECTION_PORT=$collection_port
EOF

  cat >"$root/$DOCKERFILE_REL" <<'EOF'
ARG AIOPS_BASE_IMAGE=ubuntu:24.04
FROM ${AIOPS_BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive
ARG AIOPS_UID=1000
ARG AIOPS_GID=1000
ARG AIOPS_PACKAGES="ca-certificates curl git jq build-essential python3 python3-venv python3-pip nodejs npm golang-go"
RUN apt-get update \
 && apt-get install -y --no-install-recommends ${AIOPS_PACKAGES} \
 && rm -rf /var/lib/apt/lists/* \
 && (getent group "${AIOPS_GID}" >/dev/null || groupadd --gid "${AIOPS_GID}" developer) \
 && (getent passwd "${AIOPS_UID}" >/dev/null || useradd --uid "${AIOPS_UID}" --gid "${AIOPS_GID}" --shell /bin/bash developer) \
 && install -d -o "${AIOPS_UID}" -g "${AIOPS_GID}" -m 0700 /home/developer
USER ${AIOPS_UID}:${AIOPS_GID}
ENV HOME=/home/developer
ENV CODEX_HOME=/home/developer/.codex
ENV PATH=/home/developer/.local/bin:/home/developer/.local/share/npm/bin:${PATH}
WORKDIR /workspace
CMD ["sleep", "infinity"]
EOF

  cat >"$root/$COMPOSE_REL" <<'EOF'
services:
  workspace:
    build:
      context: .
      dockerfile: .aiops/container/Dockerfile
      args:
        AIOPS_BASE_IMAGE: ${AIOPS_BASE_IMAGE}
        AIOPS_UID: ${AIOPS_UID}
        AIOPS_GID: ${AIOPS_GID}
        AIOPS_PACKAGES: ${AIOPS_PACKAGES}
    init: true
    working_dir: /workspace
    command: ["sleep", "infinity"]
    environment:
      HOME: /home/developer
      CODEX_HOME: /home/developer/.codex
      AIOPS_PROJECT_NAME: ${AIOPS_PROJECT_NAME}
    env_file:
      - path: ./.aiops/secrets/runtime.env
        required: false
    volumes:
      - type: bind
        source: .
        target: /workspace
      - type: bind
        source: ./.aiops/home
        target: /home/developer
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    networks:
      - project
networks:
  project:
    name: aiops-${AIOPS_PROJECT_NAME}
EOF

  if [[ ! -f "$root/AGENTS.md" ]]; then
    cat >"$root/AGENTS.md" <<EOF
# Project instructions: $name

This file applies only to this project. Document its architecture, commands,
quality gates, security boundaries, and agent-specific working agreements here.

Project-local Codex state lives under \`.aiops/home/.codex/\`, including its
configuration, MCP definitions, skills, and plugins. Do not point these paths at
another project or at a host-global configuration directory.
EOF
  fi

  if [[ ! -f "$root/.gitignore" ]]; then
    cat >"$root/.gitignore" <<'EOF'
.aiops/home/
.aiops/backups/
.env
EOF
  else
    for entry in '.aiops/home/' '.aiops/backups/'; do
      grep -Fxq "$entry" "$root/.gitignore" || printf '%s\n' "$entry" >>"$root/.gitignore"
    done
  fi

  chmod 0600 "$root/$ENV_REL"
  : >"$root/$SECRET_REL/runtime.env"
  chmod 0600 "$root/$SECRET_REL/runtime.env"
  cat >"$root/$AI_REL/policy.yaml" <<'EOF'
schema: 1
scope: project
allow_host_config: false
allow_host_docker_socket: false
require_asset_checksums: true
allow_mcp_inline_secrets: false
EOF
  printf '{"schema":1,"servers":{}}\n' >"$root/$AI_REL/mcp.json"
  : >"$root/$AI_REL/assets.lock"
  chmod 0644 "$root/$AI_REL/policy.yaml" "$root/$AI_REL/mcp.json" "$root/$AI_REL/assets.lock"
  chmod 0644 "$root/$COMPOSE_REL" "$root/$DOCKERFILE_REL"
}

validate_asset_name(){
  [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || die "Asset name must be lowercase and filesystem-safe."
}

asset_hash(){
  local dir="$1"
  (cd -- "$dir" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')
}

asset_lock_set(){
  local root="$1" kind="$2" name="$3" digest="$4" source="$5" lock tmp
  lock="$root/$AI_REL/assets.lock"; tmp="${lock}.tmp"
  awk -F '\t' -v k="$kind" -v n="$name" '!($1==k && $2==n)' "$lock" >"$tmp"
  printf '%s\t%s\t%s\t%s\n' "$kind" "$name" "$digest" "$source" >>"$tmp"
  sort -o "$tmp" "$tmp"; mv "$tmp" "$lock"; chmod 0644 "$lock"
}

asset_add(){
  local root kind name source destination marker digest
  root="$(project_root "${1:-$PWD}")"; kind="${2:-}"; name="${3:-}"; source="${4:-}"
  validate_asset_name "$name"; [[ -d "$source" ]] || die "Asset source directory not found: $source"
  [[ -z "$(find "$source" -type l -print -quit)" ]] || die "Asset sources may not contain symbolic links."
  case "$kind" in
    skill) destination="$root/$MANAGED_DIR/home/.codex/skills/$name"; marker=SKILL.md ;;
    plugin) destination="$root/$MANAGED_DIR/home/.codex/plugins/$name"; marker=.codex-plugin/plugin.json ;;
    *) die "Asset type must be skill or plugin." ;;
  esac
  [[ -f "$source/$marker" ]] || die "$kind source is missing $marker"
  if [[ "$kind" == skill ]]; then
    grep -Eq '^name:[[:space:]]*[^[:space:]]' "$source/SKILL.md" || die "SKILL.md is missing frontmatter name."
    grep -Eq '^description:[[:space:]]*[^[:space:]]' "$source/SKILL.md" || die "SKILL.md is missing frontmatter description."
  else
    python3 -m json.tool "$source/.codex-plugin/plugin.json" >/dev/null || die "Plugin manifest is not valid JSON."
  fi
  [[ ! -e "$destination" ]] || die "$kind already exists: $name"
  install -d -m 0700 "$(dirname "$destination")"; cp -a -- "$source" "$destination"
  digest="$(asset_hash "$destination")"; asset_lock_set "$root" "$kind" "$name" "$digest" "$(cd "$source" && pwd -P)"
  info "Added and checksum-locked $kind: $name"
}

asset_remove(){
  local root kind name destination lock tmp
  root="$(project_root "${1:-$PWD}")"; kind="${2:-}"; name="${3:-}"; validate_asset_name "$name"
  case "$kind" in skill) destination="$root/$MANAGED_DIR/home/.codex/skills/$name" ;; plugin) destination="$root/$MANAGED_DIR/home/.codex/plugins/$name" ;; *) die "Asset type must be skill or plugin." ;; esac
  [[ -d "$destination" ]] || die "$kind is not installed: $name"
  rm -rf -- "$destination"
  lock="$root/$AI_REL/assets.lock"; tmp="${lock}.tmp"
  awk -F '\t' -v k="$kind" -v n="$name" '!($1==k && $2==n)' "$lock" >"$tmp"; mv "$tmp" "$lock"
  info "Removed project-local $kind: $name"
}

asset_list(){
  local root kind="${2:-all}"
  root="$(project_root "${1:-$PWD}")"
  if [[ "$kind" == all ]]; then cat "$root/$AI_REL/assets.lock"; else awk -F '\t' -v k="$kind" '$1==k' "$root/$AI_REL/assets.lock"; fi
}

asset_verify(){
  local root kind name expected source destination actual failed=0
  root="$(project_root "${1:-$PWD}")"
  while IFS=$'\t' read -r kind name expected source; do
    [[ -n "$kind" ]] || continue
    case "$kind" in skill) destination="$root/$MANAGED_DIR/home/.codex/skills/$name" ;; plugin) destination="$root/$MANAGED_DIR/home/.codex/plugins/$name" ;; *) die "Unknown asset type in lock: $kind" ;; esac
    if [[ ! -d "$destination" ]]; then printf '[FAIL] missing %s: %s\n' "$kind" "$name" >&2; failed=1; continue; fi
    actual="$(asset_hash "$destination")"
    if [[ "$actual" == "$expected" ]]; then printf '[PASS] %s %s\n' "$kind" "$name"; else printf '[FAIL] checksum %s %s\n' "$kind" "$name" >&2; failed=1; fi
  done <"$root/$AI_REL/assets.lock"
  ((failed == 0))
}

mcp_manage(){
  local root action name
  root="$(project_root "${1:-$PWD}")"; action="${2:-list}"; name="${3:-}"; shift 3 || true
  [[ "$action" == list ]] || validate_asset_name "$name"
  require_command python3
  python3 - "$root/$AI_REL/mcp.json" "$action" "$name" "$@" <<'PY'
import json, os, re, shutil, sys, tempfile
path, action, name, *args = sys.argv[1:]
data=json.load(open(path, encoding="utf-8"))
servers=data.setdefault("servers", {})
if action == "list":
    for key, value in sorted(servers.items()):
        print(f"{key}\t{'enabled' if value.get('enabled') else 'disabled'}\t{value['command']} {' '.join(value.get('args', []))}")
elif action == "add":
    if not args: raise SystemExit("mcp add requires COMMAND [ARG...]")
    command, *command_args=args
    if not re.fullmatch(r"[A-Za-z0-9_./+-]+", command): raise SystemExit("unsafe MCP command")
    if any(re.search(r"(?i)(api[_-]?key|token|secret|password)=", x) for x in command_args):
        raise SystemExit("inline MCP secrets are forbidden; use .aiops/secrets/runtime.env")
    if name in servers: raise SystemExit(f"MCP server already exists: {name}")
    servers[name]={"command":command,"args":command_args,"enabled":False}
elif action in ("enable","disable"):
    if name not in servers: raise SystemExit(f"unknown MCP server: {name}")
    servers[name]["enabled"] = action == "enable"
elif action == "remove":
    if name not in servers: raise SystemExit(f"unknown MCP server: {name}")
    del servers[name]
elif action == "test":
    if name not in servers: raise SystemExit(f"unknown MCP server: {name}")
    command=servers[name]["command"]
    if "/" in command:
        if not os.path.isfile(command) or not os.access(command, os.X_OK): raise SystemExit("MCP command is not executable")
    elif not shutil.which(command): raise SystemExit("MCP command is not on PATH")
    print(f"MCP {name}: definition valid")
else: raise SystemExit("MCP action must be list, add, remove, enable, disable, or test")
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(path)); os.close(fd)
with open(tmp,"w",encoding="utf-8") as f: json.dump(data,f,indent=2,sort_keys=True); f.write("\n")
os.chmod(tmp,0o644); os.replace(tmp,path)
codex_config=os.path.join(os.path.dirname(os.path.dirname(path)),"home",".codex","config.toml")
begin="# BEGIN AIOPS MANAGED MCP\n"; end="# END AIOPS MANAGED MCP\n"
existing=""
if os.path.exists(codex_config): existing=open(codex_config,encoding="utf-8").read()
if begin in existing:
    before, remainder=existing.split(begin,1)
    if end not in remainder: raise SystemExit("unterminated managed MCP block in Codex config")
    _, after=remainder.split(end,1); existing=before+after.lstrip("\n")
lines=[begin]
for key,value in sorted(servers.items()):
    if not value.get("enabled"): continue
    lines += [f"[mcp_servers.{key}]\n",f"command = {json.dumps(value['command'])}\n",f"args = {json.dumps(value.get('args',[]))}\n","\n"]
lines.append(end)
rendered=existing.rstrip()+("\n\n" if existing.strip() else "")+"".join(lines)
os.makedirs(os.path.dirname(codex_config),exist_ok=True)
with open(codex_config,"w",encoding="utf-8") as f: f.write(rendered)
os.chmod(codex_config,0o600)
PY
}

ai_audit(){
  local root
  root="$(project_root "${1:-$PWD}")"
  [[ -s "$root/AGENTS.md" ]] || die "AGENTS.md is missing or empty."
  [[ -f "$root/$AI_REL/policy.yaml" && -f "$root/$AI_REL/mcp.json" && -f "$root/$AI_REL/assets.lock" ]] || die "AI management metadata is incomplete."
  asset_verify "$root"
  ! grep -ERni --exclude='*.lock' --exclude='mcp.json' '(api[_-]?key|token|secret|password)[[:space:]]*[:=][[:space:]]*[^$<{[:space:]]' "$root/AGENTS.md" "$root/$AI_REL" || die "Possible inline secret found in AI metadata."
  info "Project AI configuration audit passed: $root"
}

feature_enabled(){ [[ -f "$1/$FEATURE_REL/$2.enabled" ]]; }

env_value(){
  local file="$1" key="$2"
  awk -F= -v key="$key" '$1==key {print substr($0,index($0,"=")+1); exit}' "$file"
}

validate_port(){
  [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535)) || \
    die "Invalid loopback port: $1"
}

validate_domain(){
  [[ ${#1} -le 253 && "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ && "$1" == *.* ]] || \
    die "Invalid DNS domain: $1"
}

validate_email(){ [[ "$1" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || die "Invalid email address."; }
validate_auth_user(){ [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "Invalid authentication username."; }

edge_file(){ printf '%s/%s/%s.edge\n' "$1" "$FEATURE_REL" "$2"; }

edge_add(){
  local root feature domain email user port upstream record
  root="$(project_root "${1:-$PWD}")"; feature="${2:-}"; domain="${3:-}"; email="${4:-}"; user="${5:-projectadmin}"
  [[ "$feature" == code-server ]] || die "Supported project edge: code-server"
  feature_enabled "$root" "$feature" || die "Enable '$feature' before publishing its edge."
  validate_domain "$domain"; validate_email "$email"; validate_auth_user "$user"
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "edge-add changes system Nginx configuration; run it with sudo."
  [[ -x "$NGINX_MANAGER" ]] || die "nginx-manager is not installed at $NGINX_MANAGER"
  port="$(env_value "$root/$ENV_REL" AIOPS_CODE_SERVER_PORT)"; validate_port "$port"
  upstream="http://127.0.0.1:${port}"
  curl -fsS --connect-timeout 2 --max-time 8 "$upstream/healthz" >/dev/null || \
    die "code-server is not healthy at $upstream; start the project first."
  "$NGINX_MANAGER" proxy-add "$domain" "$upstream" "$user"
  "$NGINX_MANAGER" ssl-issue "$domain" "$email"
  "$NGINX_MANAGER" site-verify "$domain"
  record="$(edge_file "$root" "$feature")"
  printf 'DOMAIN=%s\nUPSTREAM=%s\nAUTH_USER=%s\n' "${domain,,}" "$upstream" "$user" >"$record"
  chown --reference="$root/$ENV_REL" "$record"
  chmod 0600 "$record"
  info "Project edge ready: https://${domain,,} -> $upstream"
}

edge_remove(){
  local root feature record domain
  root="$(project_root "${1:-$PWD}")"; feature="${2:-}"; record="$(edge_file "$root" "$feature")"
  [[ "$feature" == code-server ]] || die "Supported project edge: code-server"
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "edge-remove changes system Nginx configuration; run it with sudo."
  [[ -x "$NGINX_MANAGER" ]] || die "nginx-manager is not installed at $NGINX_MANAGER"
  [[ -f "$record" ]] || die "No managed edge record exists for $feature."
  domain="$(env_value "$record" DOMAIN)"; validate_domain "$domain"
  "$NGINX_MANAGER" proxy-remove "$domain"
  rm -f -- "$record"
  info "Removed project edge for $feature: $domain"
}

edge_list(){
  local root feature record
  root="$(project_root "${1:-$PWD}")"
  for feature in code-server; do
    record="$(edge_file "$root" "$feature")"
    if [[ -f "$record" ]]; then
      printf '%-14s %s -> %s\n' "$feature" "$(env_value "$record" DOMAIN)" "$(env_value "$record" UPSTREAM)"
    else
      printf '%-14s not-published\n' "$feature"
    fi
  done
}

feature_enable(){
  local root feature password
  root="$(project_root "${1:-$PWD}")"; feature="${2:-}"
  case "$feature" in
    code-server)
      require_command openssl
      password="$(openssl rand -hex 24)"
      cat >"$root/$FEATURE_REL/code-server.yaml" <<'EOF'
services:
  code-server:
    image: codercom/code-server:4.130.0
    user: "${AIOPS_UID}:${AIOPS_GID}"
    working_dir: /workspace
    environment:
      HOME: /home/coder
      PASSWORD: ${AIOPS_CODE_SERVER_PASSWORD}
    volumes:
      - type: bind
        source: .
        target: /workspace
      - type: bind
        source: ./.aiops/home
        target: /home/coder
    ports:
      - "127.0.0.1:${AIOPS_CODE_SERVER_PORT}:8080"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    networks:
      - project
EOF
      printf 'AIOPS_CODE_SERVER_PASSWORD=%s\n' "$password" >"$root/$SECRET_REL/code-server.env"
      chmod 0600 "$root/$SECRET_REL/code-server.env"
      ;;
    goose)
      install -d -m 0700 "$root/$MANAGED_DIR/home/.config/goose"
      ;;
    opencodex)
      install -d -m 0700 "$root/$MANAGED_DIR/home/.opencodex"
      ;;
    mulerouter)
      info "Set its project-specific credential with: project-manager secret-set '$root' mulerouter"
      ;;
    *) die "Supported features: code-server | goose | opencodex | mulerouter" ;;
  esac
  : >"$root/$FEATURE_REL/$feature.enabled"; chmod 0600 "$root/$FEATURE_REL/$feature.enabled"
  info "Enabled project feature: $feature"
}

feature_disable(){
  local root feature
  root="$(project_root "${1:-$PWD}")"; feature="${2:-}"
  [[ ! -f "$(edge_file "$root" "$feature")" ]] || \
    die "Remove the managed public edge first: sudo project-manager edge-remove '$root' '$feature'"
  case "$feature" in
    code-server) compose "$root" rm -sf code-server 2>/dev/null || true; rm -f -- "$root/$FEATURE_REL/code-server.yaml" ;;
    goose|opencodex|mulerouter) ;;
    *) die "Unknown feature: $feature" ;;
  esac
  rm -f -- "$root/$FEATURE_REL/$feature.enabled"
  info "Disabled feature definition; its project-local state was preserved."
}

feature_list(){
  local root feature
  root="$(project_root "${1:-$PWD}")"
  for feature in code-server goose opencodex mulerouter; do
    if feature_enabled "$root" "$feature"; then printf '%-14s enabled\n' "$feature"; else printf '%-14s disabled\n' "$feature"; fi
  done
}

tool_install(){
  local root feature
  root="$(project_root "${1:-$PWD}")"; feature="${2:-}"
  feature_enabled "$root" "$feature" || die "Enable '$feature' first."
  compose "$root" up -d workspace
  case "$feature" in
    goose)
      compose "$root" exec workspace bash -lc \
        'set -Eeuo pipefail; f=$(mktemp); trap '\''rm -f "$f"'\'' EXIT; curl -fsSL --proto "=https" --tlsv1.2 https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh -o "$f"; bash "$f"'
      ;;
    opencodex)
      compose "$root" exec workspace bash -lc \
        'set -Eeuo pipefail; npm config set prefix "$HOME/.local/share/npm"; npm install --global @bitkyc08/opencodex'
      ;;
    *) die "No workspace tool installation is required for: $feature" ;;
  esac
  info "Installed $feature inside this project's isolated home."
}

secret_set(){
  local root provider value key tmp
  root="$(project_root "${1:-$PWD}")"; provider="${2:-}"
  case "$provider" in mulerouter) key=MULEROUTER_API_KEY ;; *) die "Supported secret provider: mulerouter" ;; esac
  if [[ -n "${AIOPS_SECRET_VALUE:-}" ]]; then value="$AIOPS_SECRET_VALUE"; else
    read -r -s -p "$key: " value; printf '\n'
  fi
  [[ "$value" =~ ^[A-Za-z0-9._-]+$ ]] || die "Secret must use only letters, numbers, dot, underscore or hyphen."
  tmp="$root/$SECRET_REL/runtime.env.tmp"
  grep -v "^${key}=" "$root/$SECRET_REL/runtime.env" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  mv "$tmp" "$root/$SECRET_REL/runtime.env"; chmod 0600 "$root/$SECRET_REL/runtime.env"
  unset value
  info "Stored $provider credential in the project-only runtime secret file."
}

init_project(){
  local requested="${1:-}" name="${2:-}" root
  [[ -n "$requested" ]] || die "Usage: project-manager init PATH [NAME]"
  install -d -m 0755 "$requested"
  root="$(canonical_existing_dir "$requested")"
  [[ ! -e "$root/$MANAGED_DIR" ]] || die "Already initialized: $root"
  name="${name:-$(default_name "$root")}"; validate_name "$name"
  write_templates "$root" "$name"
  info "Initialized isolated project '$name' at $root"
  info "Edit $root/$ENV_REL and $root/$DOCKERFILE_REL for project runtimes, then run: project-manager build $root"
}

verify_project(){
  local root name
  root="$(project_root "${1:-$PWD}")"
  name="$(awk -F= '$1=="AIOPS_PROJECT_NAME" {print substr($0, index($0,"=")+1); exit}' "$root/$ENV_REL")"
  validate_name "$name"
  [[ -d "$root/$MANAGED_DIR/home/.codex/skills" ]] || die "Project-local skills directory missing."
  [[ -d "$root/$MANAGED_DIR/home/.codex/plugins" ]] || die "Project-local plugins directory missing."
  [[ -f "$root/AGENTS.md" ]] || die "Project AGENTS.md missing."
  [[ -f "$root/$AI_REL/policy.yaml" && -f "$root/$AI_REL/mcp.json" ]] || die "Project AI policy/configuration missing."
  grep -Fq 'source: ./.aiops/home' "$root/$COMPOSE_REL" || die "Isolated home mount missing."
  ! grep -Eq '(/var/run/docker.sock|/root/\.codex|\$\{HOME\}/\.codex)' "$root/$COMPOSE_REL" || \
    die "Unsafe host-global mount found in compose.yaml."
  compose "$root" config --quiet
  info "Project isolation verified: $root"
}

backup_project(){
  local root output parent base stamp
  root="$(project_root "${1:-$PWD}")"
  output="${2:-}"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"; base="$(basename "$root")"; parent="$(dirname "$root")"
  [[ -n "$output" ]] || output="$root/$MANAGED_DIR/backups/${base}-${stamp}.tar.gz"
  [[ "$output" == /* ]] || output="$PWD/$output"
  install -d -m 0700 "$(dirname "$output")"
  case "$output" in
    "$root/$MANAGED_DIR/backups"/*) ;;
    "$root"/*) die "A backup inside the project must be stored under $root/$MANAGED_DIR/backups." ;;
  esac
  require_command tar; require_command sha256sum
  tar --exclude="./$base/$MANAGED_DIR/backups" -C "$parent" -czf "$output" "./$base"
  chmod 0600 "$output"
  sha256sum "$output" >"${output}.sha256"; chmod 0600 "${output}.sha256"
  info "Backup created: $output"
  info "Checksum: ${output}.sha256"
}

validate_archive(){
  local archive="$1" entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    [[ "$entry" != /* ]] || die "Archive contains an absolute path: $entry"
    [[ "/$entry/" != *"/../"* ]] || die "Archive contains path traversal: $entry"
  done < <(tar -tzf "$archive")
}

restore_project(){
  local archive="${1:-}" destination="${2:-}" tmp top
  [[ -f "$archive" ]] || die "Backup archive not found: $archive"
  [[ -n "$destination" ]] || die "Usage: project-manager restore ARCHIVE DESTINATION"
  require_command tar
  if [[ -f "${archive}.sha256" ]]; then
    require_command sha256sum
    (cd -- "$(dirname "$archive")" && sha256sum -c "$(basename "${archive}.sha256")")
  fi
  validate_archive "$archive"
  if [[ -e "$destination" ]]; then
    [[ -d "$destination" && -z "$(find "$destination" -mindepth 1 -maxdepth 1 -print -quit)" ]] || \
      die "Restore destination must be absent or empty: $destination"
  else
    install -d -m 0755 "$destination"
  fi
  tmp="$(mktemp -d "$(dirname "$(canonical_existing_dir "$destination")")/.aiops-restore.XXXXXX")"
  trap 'rm -rf -- "$tmp"' RETURN
  tar -xzf "$archive" -C "$tmp" --no-same-owner
  top="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d -print -quit)"
  [[ -n "$top" && -f "$top/$ENV_REL" ]] || die "Archive is not a project-manager backup."
  cp -a -- "$top"/. "$destination"/
  trap - RETURN; rm -rf -- "$tmp"
  info "Project restored to: $(canonical_existing_dir "$destination")"
  info "Run 'project-manager verify $destination' before starting it."
}

destroy_project(){
  local root confirm="${2:-}"
  root="$(project_root "${1:-$PWD}")"
  [[ "$confirm" == --yes ]] || die "Destructive operation. Re-run: project-manager destroy '$root' --yes"
  [[ -z "$(find "$root/$FEATURE_REL" -maxdepth 1 -type f -name '*.edge' -print -quit)" ]] || \
    die "Remove all managed public edges before destroying this project."
  compose "$root" down --remove-orphans
  rm -rf -- "$root/$MANAGED_DIR"
  info "Removed project containers and isolated state. Source files were preserved."
}

help(){
  cat <<EOF
project-manager $MANAGER_VERSION

Create one containerized development environment per project. Each project has
its own HOME, CODEX_HOME, skills, plugins, MCP configuration, agent state,
dependencies, Compose network, and source mount.

Lifecycle:
  init PATH [NAME]          Create an isolated project definition
  build [PATH]              Build its workspace image
  up [PATH]                 Build and start it
  down [PATH]               Stop and remove its containers
  shell [PATH]              Open a shell as the unprivileged developer
  run [PATH] -- COMMAND...  Run a command in the workspace
  status [PATH]             Show container status
  verify [PATH]             Validate isolation and Compose configuration

Protection:
  backup [PATH] [FILE]      Back up source plus isolated configuration/state
  restore ARCHIVE PATH      Restore into an absent or empty directory
  destroy [PATH] --yes      Remove containers and .aiops state; preserve source

Project features:
  features [PATH]
  feature-enable PATH NAME  code-server | goose | opencodex | mulerouter
  feature-disable PATH NAME Preserve feature state while disabling it
  tool-install PATH NAME    Install enabled Goose/OpenCodex in isolated HOME
  secret-set PATH NAME      Prompt for a project-specific provider credential

AI configuration:
  asset-add PATH skill|plugin NAME SOURCE_DIR
  asset-remove PATH skill|plugin NAME
  assets PATH [skill|plugin|all]
  asset-verify PATH         Verify locked project asset checksums
  mcp PATH ACTION NAME [COMMAND [ARG...]]
                            list|add|remove|enable|disable|test
  ai-audit PATH             Audit AGENTS, skills, plugins, MCP and policy

HTTPS edge (code-server):
  edge-add PATH NAME DOMAIN EMAIL [AUTH_USER]
                            Create Basic-Auth Nginx proxy and TLS certificate
  edge-remove PATH NAME     Remove the managed Nginx proxy
  edges [PATH]              List project UI publication state

The host Docker socket and host AI-tool configuration are never mounted.

Initialization maps the calling user's UID/GID. When invoked by root it uses
the unprivileged 10000:10000 identity; override with AIOPS_PROJECT_UID and
AIOPS_PROJECT_GID when a different mapping is required.
EOF
}

main(){
  local command="${1:-help}" root
  shift || true
  case "$command" in
    init) init_project "${1:-}" "${2:-}" ;;
    build) root="$(project_root "${1:-$PWD}")"; compose "$root" build ;;
    up|start) root="$(project_root "${1:-$PWD}")"; compose "$root" up -d --build ;;
    down|stop) root="$(project_root "${1:-$PWD}")"; compose "$root" down --remove-orphans ;;
    shell) root="$(project_root "${1:-$PWD}")"; compose "$root" exec workspace bash ;;
    run)
      if [[ "${1:-}" == -- ]]; then
        root="$(project_root "$PWD")"; shift
      else
        root="$(project_root "${1:-$PWD}")"; shift || true
        [[ "${1:-}" == -- ]] && shift
      fi
      (($#)) || die "run requires a command after '--'."
      compose "$root" exec workspace "$@"
      ;;
    status) root="$(project_root "${1:-$PWD}")"; compose "$root" ps ;;
    features) feature_list "${1:-$PWD}" ;;
    feature-enable) feature_enable "${1:-$PWD}" "${2:-}" ;;
    feature-disable) feature_disable "${1:-$PWD}" "${2:-}" ;;
    tool-install) tool_install "${1:-$PWD}" "${2:-}" ;;
    secret-set) secret_set "${1:-$PWD}" "${2:-}" ;;
    asset-add) asset_add "${1:-$PWD}" "${2:-}" "${3:-}" "${4:-}" ;;
    asset-remove) asset_remove "${1:-$PWD}" "${2:-}" "${3:-}" ;;
    assets) asset_list "${1:-$PWD}" "${2:-all}" ;;
    asset-verify) asset_verify "${1:-$PWD}" ;;
    mcp) mcp_manage "${1:-$PWD}" "${2:-list}" "${3:-}" "${@:4}" ;;
    ai-audit) ai_audit "${1:-$PWD}" ;;
    edge-add) edge_add "${1:-$PWD}" "${2:-}" "${3:-}" "${4:-}" "${5:-projectadmin}" ;;
    edge-remove) edge_remove "${1:-$PWD}" "${2:-}" ;;
    edges) edge_list "${1:-$PWD}" ;;
    verify) verify_project "${1:-$PWD}" ;;
    backup) backup_project "${1:-$PWD}" "${2:-}" ;;
    restore) restore_project "${1:-}" "${2:-}" ;;
    destroy) destroy_project "${1:-$PWD}" "${2:-}" ;;
    version) echo "project-manager $MANAGER_VERSION" ;;
    help|-h|--help) help ;;
    *) help >&2; die "Unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
