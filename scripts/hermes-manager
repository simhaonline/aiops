    hm_require_root
    hm_ensure_user
    hm_hermes insights "$@"
}

hm_browser_install() {
    hm_begin_mutation
    hm_install_dependencies
    hm_ensure_user

    local tmp
    tmp="$(mktemp /tmp/hermes-install.XXXXXX.sh)"
    hm_download_installer "$tmp"

    hm_log "Installing Hermes browser dependencies"
    hm_run_as_user bash "$tmp" \
        --ensure node,browser \
        --hermes-home "$HERMES_HOME"

    rm -f "$tmp"
}

hm_computer_use_install() {
    hm_require_root
    hm_ensure_user
    hm_hermes computer-use install
}

hm_nginx_setup() {
    hm_require_root

    local domain="${1:-}"
    local email="${2:-}"
    local user="${3:-hermesadmin}"

    [[ -n "$domain" && -n "$email" ]] || \
        hm_die "Usage: hermes-manager nginx-setup DOMAIN EMAIL [AUTH_USER]"
    [[ -x "$NGINX_MANAGER" ]] || \
        hm_die "nginx-manager is not installed: $NGINX_MANAGER"

    cat <<EOF
Hermes dashboard contains API keys/secrets and can execute agent commands.

The official Hermes documentation recommends OAuth/OIDC for dashboards exposed
directly to the public Internet. This helper instead keeps Hermes bound only to
127.0.0.1 and places nginx-manager HTTPS + Basic Auth in front of it.

Use this only when that access model is acceptable to you, preferably with VPN
or additional upstream access controls.
EOF

    local answer=""
    read -r -p "Type PROTECT-HERMES-WITH-NGINX to continue: " answer
    [[ "$answer" == "PROTECT-HERMES-WITH-NGINX" ]] || hm_die "Cancelled."

    "$NGINX_MANAGER" proxy-add "$domain" "$HERMES_DASHBOARD_URL" "$user"
    "$NGINX_MANAGER" ssl-issue "$domain" "$email"
    "$NGINX_MANAGER" site-verify "$domain"

    hm_info "Hermes dashboard edge configured: https://${domain}"
}

hm_local_access() {
    echo "Hermes dashboard local-only URL:"
    echo "  $HERMES_DASHBOARD_URL"
    echo
    echo "From your workstation:"
    echo "  ssh -N -L ${HERMES_DASHBOARD_PORT}:127.0.0.1:${HERMES_DASHBOARD_PORT} root@SERVER_IP"
    echo
    echo "Then browse:"
    echo "  http://localhost:${HERMES_DASHBOARD_PORT}"
}

hm_verify_loopback_listener() {
    local endpoints
    endpoints="$(
        {
            ss -H -lnt4 "( sport = :${HERMES_DASHBOARD_PORT} )" 2>/dev/null || true
            ss -H -lnt6 "( sport = :${HERMES_DASHBOARD_PORT} )" 2>/dev/null || true
        } | awk '{print $4}' | sort -u
    )"

    [[ -n "$endpoints" ]] || hm_die "Dashboard port ${HERMES_DASHBOARD_PORT} is not listening."

    local ep
    while IFS= read -r ep; do
        [[ -n "$ep" ]] || continue
        case "$ep" in
            "127.0.0.1:${HERMES_DASHBOARD_PORT}"|"[::1]:${HERMES_DASHBOARD_PORT}"|"::1:${HERMES_DASHBOARD_PORT}")
                ;;
            *)
                hm_die "Unsafe Hermes dashboard listener: $ep"
                ;;
        esac
    done <<<"$endpoints"

    printf '%s\n' "$endpoints"
}

hm_verify() {
    hm_require_root
    hm_require_ubuntu_2404

    echo "=== Hermes Agent verification ==="

    echo "[1/10] Canonical manager"
    [[ "$(hm_canonical_version)" == "$HERMES_MANAGER_VERSION" ]] || \
        hm_die "Canonical manager version mismatch."

    echo "[2/10] Service identity / paths"
    id "$HERMES_USER" >/dev/null 2>&1 || hm_die "Hermes service user missing."
    [[ "$(getent passwd "$HERMES_USER" | awk -F: '{print $6}')" == "$HERMES_HOME_ROOT" ]] || \
        hm_die "Unexpected Hermes service-user home."
    [[ -d "$HERMES_HOME" ]] || hm_die "Hermes state directory missing."

    echo "[3/10] CLI runtime"
    [[ -x "$HERMES_LAUNCHER" ]] || hm_die "Hermes launcher missing."
    [[ -x "$HERMES_WRAPPER" ]] || hm_die "System Hermes wrapper missing."
    local version
    version="$(hm_hermes version 2>&1 || hm_hermes --version 2>&1 || true)"
    [[ -n "$version" ]] || hm_die "Hermes CLI version check failed."

    echo "[4/10] Python / dashboard dependencies"
    [[ -x "$HERMES_PYTHON" ]] || hm_die "Hermes venv Python missing."
    hm_run_as_user "$HERMES_PYTHON" - <<'PY'
import fastapi
import uvicorn
import ptyprocess
print("hermes-dashboard-deps-ok")
PY

    echo "[5/10] Dashboard systemd unit"
    [[ -f "$HERMES_SERVICE_FILE" ]] || hm_die "Dashboard service unit missing."
    systemctl is-enabled --quiet "$HERMES_SERVICE" || hm_die "Dashboard service is not enabled."
    systemctl is-active --quiet "$HERMES_SERVICE" || hm_die "Dashboard service is not active."

    echo "[6/10] Dashboard loopback isolation"
    local listeners
    listeners="$(hm_verify_loopback_listener)"
    hm_info "Dashboard listener(s): $(tr '\n' ' ' <<<"$listeners" | xargs)"

    echo "[7/10] Dashboard API health"
    curl -fsS --connect-timeout 2 --max-time 8 \
        "${HERMES_DASHBOARD_URL}/api/status" >/dev/null || \
        hm_die "Dashboard /api/status failed."

    echo "[8/10] State ownership"
    local wrong_owner
    wrong_owner="$(
        find "$HERMES_HOME_ROOT" -xdev \
            ! -user "$HERMES_USER" \
            -print -quit 2>/dev/null || true
    )"
    [[ -z "$wrong_owner" ]] || \
        hm_die "Found non-${HERMES_USER} owned state path: $wrong_owner"

    echo "[9/10] Projects"
    local p
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ -d "$p" ]] || hm_die "Registered project disappeared: $p"
        hm_run_as_user test -r "$p" || hm_die "Hermes cannot read project: $p"
        hm_run_as_user test -w "$p" || hm_die "Hermes cannot write project: $p"
    done < <(hm_projects_raw)

    echo "[10/10] Public-port safety"
    if ss -H -lnt "( sport = :${HERMES_DASHBOARD_PORT} )" | \
        awk '{print $4}' | grep -Evq '^(127\.0\.0\.1:|\[::1\]:|::1:)'; then
        hm_die "Hermes dashboard has a non-loopback listener."
    fi

    echo
    echo "HERMES AGENT: VERIFIED"
    echo "Manager:   ${HERMES_MANAGER_VERSION}"
    echo "Hermes:    ${version//$'\n'/ }"
    echo "User:      ${HERMES_USER}:${HERMES_GROUP}"
    echo "Home:      ${HERMES_HOME}"
    echo "Dashboard: ${HERMES_DASHBOARD_URL}"
}

hm_status() {
    hm_require_root

    echo "=== Hermes Agent Manager ==="
    echo "Manager:    $HERMES_MANAGER_VERSION"
    echo "Canonical:  $(hm_canonical_version)"
    echo "User:       $HERMES_USER"
    echo "Home:       $HERMES_HOME"
    echo "Code:       $HERMES_CODE"
    echo "Dashboard:  $HERMES_DASHBOARD_URL"
    echo

    if [[ -x "$HERMES_LAUNCHER" ]]; then
        hm_hermes version 2>/dev/null || hm_hermes --version 2>/dev/null || true
    else
        echo "Hermes CLI: NOT INSTALLED"
    fi

    echo
    hm_dashboard_status

    echo
    hm_projects
}

hm_doctor() {
    hm_require_root

    echo "=== hermes-manager doctor ==="

    echo
    echo "=== OS ==="
    grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release || true

    echo
    echo "=== Identity ==="
    id "$HERMES_USER" 2>/dev/null || true
    getent passwd "$HERMES_USER" || true

    echo
    echo "=== Paths ==="
    ls -ld \
        "$HERMES_HOME_ROOT" \
        "$HERMES_HOME" \
        "$HERMES_CODE" \
        "$HERMES_LOCAL_BIN" \
        "$HERMES_LAUNCHER" \
        "$HERMES_WRAPPER" 2>/dev/null || true

    echo
    echo "=== Versions ==="
    [[ -x "$HERMES_LAUNCHER" ]] && \
        (hm_hermes version 2>/dev/null || hm_hermes --version 2>/dev/null || true)
    [[ -x "$HERMES_PYTHON" ]] && hm_run_as_user "$HERMES_PYTHON" --version || true
    local uv=""
    uv="$(hm_find_uv 2>/dev/null || true)"
    [[ -n "$uv" ]] && hm_run_as_user "$uv" --version || true

    echo
    echo "=== Dashboard ==="
    systemctl --no-pager --full status "$HERMES_SERVICE" 2>/dev/null | \
        sed -n '1,35p' || true

    echo
    echo "=== Listeners ==="
    ss -H -lntp 2>/dev/null | grep -E ":${HERMES_DASHBOARD_PORT}\b" || true

    echo
    echo "=== API status ==="
    curl -fsS "${HERMES_DASHBOARD_URL}/api/status" | jq . 2>/dev/null || true

    echo
    echo "=== Projects ==="
    hm_projects

    echo
    echo "=== Recent dashboard logs ==="
    journalctl -u "$HERMES_SERVICE" -n 100 --no-pager 2>/dev/null || true
}

hm_version() {
    echo "hermes-manager $HERMES_MANAGER_VERSION"
    if [[ -x "$HERMES_LAUNCHER" ]]; then
        hm_hermes version 2>/dev/null || hm_hermes --version 2>/dev/null || true
    fi
}

hm_help() {
    cat <<EOF
hermes-manager v${HERMES_MANAGER_VERSION}
Ubuntu 24.04 LTS

Nous Research Hermes Agent CLI + Web Dashboard manager.

Lifecycle:
  install
  repair
  update
  check-update
  reinstall
  delete | uninstall
  purge

Inspection:
  status
  verify
  doctor
  version

CLI / setup:
  cli [HERMES_ARGS...]
  setup
  setup-portal
  model
  tools
  plugins [ARGS...]
  mcp [ARGS...]
  sessions [ARGS...]
  insights [ARGS...]

Dashboard:
  dashboard-start
  dashboard-stop
  dashboard-restart
  dashboard-status
  dashboard-logs [LINES]
  dashboard-follow
  local-access

Projects:
  project-add /absolute/path
  project-remove /absolute/path
  project-check /absolute/path
  projects

Optional features:
  browser-install
  computer-use-install

Public edge:
  nginx-setup DOMAIN EMAIL [AUTH_USER]

Backup:
  backup [ABSOLUTE_FILE]

Defaults:
  Service user: ${HERMES_USER}:${HERMES_GROUP}
  Home:         ${HERMES_HOME_ROOT}
  HERMES_HOME:  ${HERMES_HOME}
  Code:         ${HERMES_CODE}
  Dashboard:    ${HERMES_DASHBOARD_URL}
  Manager:      ${HERMES_MANAGER_PATH}

Examples:
  sudo ./hermes-manager install
  sudo hermes-manager setup-portal
  hermes
  hermes --tui
  sudo hermes-manager project-add /srv/predict-a-trade
  sudo hermes-manager dashboard-status
  sudo hermes-manager nginx-setup hermes.example.com admin@example.com hermesadmin

Security:
  - Hermes does not run as root.
  - gcc, python3-dev and libffi-dev are installed by the manager as root before setup.
  - The hermes runtime account is never granted sudo membership.
  - uv/Python XDG directories are explicitly writable by the hermes account.
  - CLI wrapper runs Hermes as the dedicated '${HERMES_USER}' account.
  - Dashboard binds only to 127.0.0.1:${HERMES_DASHBOARD_PORT}.
  - Project access is opt-in via ACL.
  - Browser and Computer Use are not enabled during the core install.
  - Public HTTPS/authentication is delegated to nginx-manager.
  - For direct Internet-facing Hermes deployments, use the official Hermes
    OAuth/OIDC guidance rather than exposing port ${HERMES_DASHBOARD_PORT}.
EOF
}

hm_main() {
    local cmd="${1:-help}"

    case "$cmd" in
        install) hm_install ;;
        repair) hm_repair ;;
        update) hm_update ;;
        check-update) hm_check_update ;;
        reinstall) hm_reinstall ;;
        delete|remove|uninstall) hm_delete ;;
        purge) hm_purge ;;

        status) hm_status ;;
        verify) hm_verify ;;
        doctor) hm_doctor ;;
        version) hm_version ;;

        cli)
            shift
            hm_cli "$@"
            ;;
        setup) hm_setup ;;
        setup-portal) hm_setup_portal ;;
        model) hm_model ;;
        tools) hm_tools ;;
        plugins)
            shift
            hm_plugins "$@"
            ;;
        mcp)
            shift
            hm_mcp "$@"
            ;;
        sessions)
            shift
            hm_sessions "$@"
            ;;
        insights)
            shift
            hm_insights "$@"
            ;;

        dashboard-start) hm_start_dashboard ;;
        dashboard-stop) hm_stop_dashboard ;;
        dashboard-restart) hm_restart_dashboard ;;
        dashboard-status) hm_dashboard_status ;;
        dashboard-logs)
            shift
            hm_dashboard_logs "${1:-$HERMES_LOG_LINES}"
            ;;
        dashboard-follow) hm_dashboard_follow ;;
        local-access) hm_local_access ;;

        project-add)
            shift
            hm_project_add "${1:-}"
            ;;
        project-remove)
            shift
            hm_project_remove "${1:-}"
            ;;
        project-check)
            shift
            hm_project_check "${1:-}"
            ;;
        projects|project-list) hm_projects ;;

        browser-install) hm_browser_install ;;
        computer-use-install) hm_computer_use_install ;;

        nginx-setup)
            shift
            hm_nginx_setup "${1:-}" "${2:-}" "${3:-hermesadmin}"
            ;;

        backup)
            shift
            hm_backup "${1:-}"
            ;;

        help|-h|--help) hm_help ;;
        *)
            hm_help >&2
            hm_die "Unknown command: $cmd"
            ;;
    esac
}

hm_main "$@"
