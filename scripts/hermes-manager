#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 027

# =============================================================================
# hermes-manager
# Version: 1.0.1
# Target: Ubuntu 24.04 LTS
#
# Production lifecycle manager for Nous Research Hermes Agent:
#   - CLI / TUI
#   - built-in Web Dashboard
#   - systemd dashboard service
#   - opt-in project ACLs
#   - update / repair / backup / verification
#   - optional nginx-manager public edge
#
# Security model:
#   - Hermes runs as dedicated unprivileged user: hermes
#   - Hermes state: /var/lib/hermes-agent/.hermes
#   - Hermes dashboard: 127.0.0.1:9119 only
#   - Project write access is opt-in with ACLs
#   - Public HTTPS is delegated to nginx-manager
#   - The manager never exposes 9119 directly to the Internet
#
# Installation model:
#   - The official Hermes installer is downloaded to a private temporary file
#     and executed as the unprivileged hermes user (never curl|bash).
#   - Browser / Computer Use are skipped during the core install to keep the
#     server runtime small and deterministic. They can be enabled later.
#   - Web + PTY extras are installed explicitly for the dashboard + Chat tab.
# =============================================================================

readonly HERMES_MANAGER_VERSION="1.0.1"
readonly HERMES_MANAGER_PATH="/usr/local/bin/hermes-manager"
readonly HERMES_LOCK_FILE="/run/lock/hermes-manager.lock"

readonly HERMES_USER="hermes"
readonly HERMES_GROUP="hermes"
readonly HERMES_HOME_ROOT="/var/lib/hermes-agent"
readonly HERMES_HOME="${HERMES_HOME_ROOT}/.hermes"
readonly HERMES_CODE="${HERMES_HOME}/hermes-agent"
readonly HERMES_LOCAL_DIR="${HERMES_HOME_ROOT}/.local"
readonly HERMES_LOCAL_BIN="${HERMES_LOCAL_DIR}/bin"
readonly HERMES_LOCAL_SHARE="${HERMES_LOCAL_DIR}/share"
readonly HERMES_CACHE_DIR="${HERMES_HOME_ROOT}/.cache"
readonly HERMES_CONFIG_HOME="${HERMES_HOME_ROOT}/.config"

readonly HERMES_LAUNCHER="${HERMES_LOCAL_BIN}/hermes"
readonly HERMES_VENV="${HERMES_CODE}/venv"
readonly HERMES_VENV_BIN="${HERMES_VENV}/bin"
readonly HERMES_PYTHON="${HERMES_VENV_BIN}/python"

# Current official installer owns its uv binary under HERMES_HOME/bin.
readonly HERMES_MANAGED_BIN="${HERMES_HOME}/bin"
readonly HERMES_UV="${HERMES_MANAGED_BIN}/uv"
readonly HERMES_UV_PYTHON_DIR="${HERMES_LOCAL_SHARE}/uv/python"
readonly HERMES_UV_PYTHON_BIN_DIR="${HERMES_LOCAL_BIN}"

readonly HERMES_WRAPPER="/usr/local/bin/hermes"
readonly HERMES_SERVICE="hermes-dashboard.service"
readonly HERMES_SERVICE_FILE="/etc/systemd/system/${HERMES_SERVICE}"
readonly HERMES_CONFIG_DIR="/etc/hermes-manager"
readonly HERMES_PROJECTS="${HERMES_CONFIG_DIR}/projects.conf"

readonly HERMES_DASHBOARD_HOST="127.0.0.1"
readonly HERMES_DASHBOARD_PORT="${HERMES_DASHBOARD_PORT:-9119}"
readonly HERMES_DASHBOARD_URL="http://${HERMES_DASHBOARD_HOST}:${HERMES_DASHBOARD_PORT}"

readonly HERMES_INSTALL_URL="https://hermes-agent.nousresearch.com/install.sh"
readonly NGINX_MANAGER="/usr/local/bin/nginx-manager"

HERMES_LOCK_TIMEOUT="${LOCK_TIMEOUT:-120}"
HERMES_APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
HERMES_LOG_LINES="${LOG_LINES:-200}"

hm_log()  { printf '\n==> %s\n' "$*"; }
hm_info() { printf '[INFO] %s\n' "$*"; }
hm_warn() { printf '[WARN] %s\n' "$*" >&2; }
hm_die()  { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

hm_err_trap() {
    local rc=$?
    printf '[ERROR] hermes-manager failed at line %s (exit %s).\n' \
        "${BASH_LINENO[0]:-unknown}" "$rc" >&2
    exit "$rc"
}
trap hm_err_trap ERR

hm_require_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] || hm_die "Run this command with sudo/root."
}

hm_require_ubuntu_2404() {
    [[ -r /etc/os-release ]] || hm_die "Cannot read /etc/os-release."
    # shellcheck disable=SC1091
    source /etc/os-release
    [[ "${ID:-}" == "ubuntu" ]] || hm_die "Ubuntu is required."
    [[ "${VERSION_ID:-}" == "24.04" ]] || \
        hm_die "Validated for Ubuntu 24.04 LTS; found ${PRETTY_NAME:-unknown}."
}

hm_lock() {
    install -d -m 0755 /run/lock
    exec 9>"$HERMES_LOCK_FILE"
    flock -w "$HERMES_LOCK_TIMEOUT" 9 || \
        hm_die "Another hermes-manager operation is active."
}

hm_apt() {
    DEBIAN_FRONTEND=noninteractive \
        apt-get -o "DPkg::Lock::Timeout=${HERMES_APT_LOCK_TIMEOUT}" "$@"
}

hm_source_path() {
    readlink -f "${BASH_SOURCE[0]}"
}

hm_self_install() {
    local src
    src="$(hm_source_path)"
    if [[ "$src" != "$HERMES_MANAGER_PATH" ]]; then
        install -o root -g root -m 0755 "$src" "$HERMES_MANAGER_PATH"
        hm_info "Installed manager -> $HERMES_MANAGER_PATH"
    else
        chown root:root "$HERMES_MANAGER_PATH"
        chmod 0755 "$HERMES_MANAGER_PATH"
    fi
}

hm_canonical_version() {
    if [[ ! -r "$HERMES_MANAGER_PATH" ]]; then
        echo "not-installed"
        return 0
    fi

    sed -nE 's/^readonly HERMES_MANAGER_VERSION="([^"]+)".*/\1/p' \
        "$HERMES_MANAGER_PATH" | head -1
}

hm_begin_mutation() {
    hm_require_root
    hm_require_ubuntu_2404
    hm_lock
    hm_self_install
}

hm_install_dependencies() {
    # Keep these aligned with the official Hermes Ubuntu/Debian installer.
    # Install them here as root so the unprivileged Hermes service account
    # never needs sudo or a password during Hermes setup.
    local packages=(
        acl
        build-essential
        gcc
        python3-dev
        libffi-dev
        ca-certificates
        curl
        ffmpeg
        git
        jq
        openssl
        ripgrep
        tar
        util-linux
        xz-utils
    )
    local missing=() pkg

    for pkg in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | \
            grep -q '^install ok installed$'; then
            missing+=("$pkg")
        fi
    done

    if ((${#missing[@]} == 0)); then
        hm_info "Required OS/build packages already installed."
    else
        hm_log "Installing Hermes OS/build dependencies as root"
        hm_info "Missing: ${missing[*]}"
        hm_apt update
        hm_apt install -y --no-install-recommends "${missing[@]}"
    fi

    # Exact build-tool probe used by the official installer.
    for pkg in gcc python3-dev libffi-dev; do
        dpkg -s "$pkg" >/dev/null 2>&1 || \
            hm_die "Hermes build prerequisite is still missing: $pkg"
    done
}

hm_ensure_user() {
    if ! id "$HERMES_USER" >/dev/null 2>&1; then
        if getent group "$HERMES_GROUP" >/dev/null 2>&1; then
            useradd \
                --system \
                --gid "$HERMES_GROUP" \
                --create-home \
                --home-dir "$HERMES_HOME_ROOT" \
                --shell /bin/bash \
                "$HERMES_USER"
        else
            useradd \
                --system \
                --user-group \
                --create-home \
                --home-dir "$HERMES_HOME_ROOT" \
                --shell /bin/bash \
                "$HERMES_USER"
        fi
        hm_info "Created service account: ${HERMES_USER}:${HERMES_GROUP}"
    fi

    local home
    home="$(getent passwd "$HERMES_USER" | awk -F: '{print $6}')"
    [[ "$home" == "$HERMES_HOME_ROOT" ]] || \
        hm_die "Existing '${HERMES_USER}' home is '$home', expected '$HERMES_HOME_ROOT'."

    # The Hermes runtime account must remain unprivileged.
    if id -nG "$HERMES_USER" 2>/dev/null | tr ' ' '\n' | grep -Fxq sudo; then
        hm_die "Refusing unsafe configuration: '${HERMES_USER}' is a member of the sudo group."
    fi

    # Explicitly own every writable parent required by uv/Hermes.
    install -d -o "$HERMES_USER" -g "$HERMES_GROUP" -m 0750 \
        "$HERMES_HOME_ROOT" \
        "$HERMES_HOME" \
        "$HERMES_MANAGED_BIN" \
        "$HERMES_LOCAL_DIR" \
        "$HERMES_LOCAL_BIN" \
        "$HERMES_LOCAL_SHARE" \
        "$HERMES_CACHE_DIR" \
        "$HERMES_CONFIG_HOME"

    chown "$HERMES_USER":"$HERMES_GROUP" \
        "$HERMES_HOME_ROOT" \
        "$HERMES_HOME" \
        "$HERMES_MANAGED_BIN" \
        "$HERMES_LOCAL_DIR" \
        "$HERMES_LOCAL_BIN" \
        "$HERMES_LOCAL_SHARE" \
        "$HERMES_CACHE_DIR" \
        "$HERMES_CONFIG_HOME"

    install -d -o root -g root -m 0755 "$HERMES_CONFIG_DIR"

    if [[ ! -f "$HERMES_PROJECTS" ]]; then
        install -o root -g root -m 0644 /dev/null "$HERMES_PROJECTS"
    fi
}

hm_runtime_path() {
    local p="${HERMES_VENV_BIN}:${HERMES_MANAGED_BIN}:${HERMES_LOCAL_BIN}:${HERMES_HOME}/node/bin"
    p+="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    printf '%s\n' "$p"
}

hm_run_as_user() {
    local path
    path="$(hm_runtime_path)"

    runuser -u "$HERMES_USER" -- env \
        HOME="$HERMES_HOME_ROOT" \
        USER="$HERMES_USER" \
        LOGNAME="$HERMES_USER" \
        HERMES_HOME="$HERMES_HOME" \
        XDG_DATA_HOME="$HERMES_LOCAL_SHARE" \
        XDG_CACHE_HOME="$HERMES_CACHE_DIR" \
        XDG_CONFIG_HOME="$HERMES_CONFIG_HOME" \
        UV_PYTHON_INSTALL_DIR="$HERMES_UV_PYTHON_DIR" \
        UV_PYTHON_BIN_DIR="$HERMES_UV_PYTHON_BIN_DIR" \
        UV_NO_CONFIG=1 \
        PATH="$path" \
        TERM="${TERM:-xterm-256color}" \
        LANG="${LANG:-C.UTF-8}" \
        "$@"
}

hm_hermes() {
    [[ -x "$HERMES_LAUNCHER" ]] || \
        hm_die "Hermes launcher is missing: $HERMES_LAUNCHER"

    if [[ -x "$HERMES_PYTHON" ]]; then
        hm_run_as_user env \
            VIRTUAL_ENV="$HERMES_VENV" \
            PATH="${HERMES_VENV_BIN}:$(hm_runtime_path)" \
            "$HERMES_LAUNCHER" "$@"
    else
        hm_run_as_user "$HERMES_LAUNCHER" "$@"
    fi
}

hm_download_installer() {
    local out="$1"

    curl -fL \
        --proto '=https' \
        --tlsv1.2 \
        --connect-timeout 10 \
        --max-time 180 \
        --retry 3 \
        --retry-delay 1 \
        "$HERMES_INSTALL_URL" \
        -o "$out"

    [[ -s "$out" ]] || hm_die "Downloaded Hermes installer is empty."
    chmod 0755 "$out"

    grep -Fq 'Hermes Agent Installer' "$out" || \
        hm_die "Downloaded file does not look like the Hermes installer."
    grep -Fq 'NousResearch/hermes-agent' "$out" || \
        hm_die "Downloaded installer does not reference the expected repository."
}

hm_run_official_installer() {
    local tmp
    tmp="$(mktemp /tmp/hermes-install.XXXXXX.sh)"

    hm_download_installer "$tmp"

    hm_log "Running official Hermes installer as '${HERMES_USER}'"

    hm_run_as_user bash "$tmp" \
        --non-interactive \
        --skip-setup \
        --skip-browser \
        --skip-computer-use \
        --hermes-home "$HERMES_HOME"

    rm -f "$tmp"

    [[ -x "$HERMES_LAUNCHER" ]] || \
        hm_die "Hermes installer completed but launcher is missing."
    [[ -d "$HERMES_CODE" ]] || \
        hm_die "Hermes source tree is missing after install."
}

hm_find_uv() {
    if [[ -x "$HERMES_UV" ]]; then
        printf '%s\n' "$HERMES_UV"
        return 0
    fi

    if [[ -x "$HERMES_HOME_ROOT/.cargo/bin/uv" ]]; then
        printf '%s\n' "$HERMES_HOME_ROOT/.cargo/bin/uv"
        return 0
    fi

    local found=""
    found="$(hm_run_as_user bash -lc 'command -v uv || true' 2>/dev/null || true)"
    [[ -n "$found" ]] || return 1
    printf '%s\n' "$found"
}

hm_install_dashboard_extras() {
    [[ -d "$HERMES_CODE" ]] || hm_die "Hermes code tree is missing."
    [[ -x "$HERMES_PYTHON" ]] || \
        hm_die "Hermes virtual-environment Python is missing: $HERMES_PYTHON"

    local uv
    uv="$(hm_find_uv)" || hm_die "Managed uv is unavailable after Hermes installation."

    hm_log "Installing Hermes web + PTY dashboard extras"
    (
        cd "$HERMES_CODE"
        hm_run_as_user "$uv" pip install \
            --python "$HERMES_PYTHON" \
            -e ".[web,pty]"
    )
}

hm_write_cli_wrapper() {
    cat >"$HERMES_WRAPPER" <<EOF
#!/usr/bin/env bash
set -Eeuo pipefail
IFS=\$'\\n\\t'

HERMES_USER="${HERMES_USER}"
HERMES_HOME_ROOT="${HERMES_HOME_ROOT}"
HERMES_HOME="${HERMES_HOME}"
HERMES_BIN="${HERMES_LAUNCHER}"

[[ -x "\$HERMES_BIN" ]] || {
    echo "[ERROR] Hermes launcher missing: \$HERMES_BIN" >&2
    exit 1
}

exec runuser -u "\$HERMES_USER" -- env \
    HOME="\$HERMES_HOME_ROOT" \
    USER="\$HERMES_USER" \
    LOGNAME="\$HERMES_USER" \
    HERMES_HOME="\$HERMES_HOME" \
    VIRTUAL_ENV="${HERMES_VENV}" \
    XDG_DATA_HOME="${HERMES_LOCAL_SHARE}" \
    XDG_CACHE_HOME="${HERMES_CACHE_DIR}" \
    XDG_CONFIG_HOME="${HERMES_CONFIG_HOME}" \
    UV_PYTHON_INSTALL_DIR="${HERMES_UV_PYTHON_DIR}" \
    UV_PYTHON_BIN_DIR="${HERMES_UV_PYTHON_BIN_DIR}" \
    UV_NO_CONFIG=1 \
    PATH="${HERMES_VENV_BIN}:${HERMES_MANAGED_BIN}:${HERMES_LOCAL_BIN}:${HERMES_HOME}/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    TERM="\${TERM:-xterm-256color}" \
    LANG="\${LANG:-C.UTF-8}" \
    "\$HERMES_BIN" "\$@"
EOF

    chown root:root "$HERMES_WRAPPER"
    chmod 0755 "$HERMES_WRAPPER"
}

hm_projects_raw() {
    [[ -f "$HERMES_PROJECTS" ]] || return 0
    sed -e 's/[[:space:]]*$//' \
        -e '/^[[:space:]]*$/d' \
        -e '/^[[:space:]]*#/d' \
        "$HERMES_PROJECTS"
}

hm_validate_project_path() {
    local p="$1"

    [[ "$p" == /* ]] || return 1
    [[ -d "$p" ]] || return 1
    [[ ! -L "$p" ]] || return 1

    case "$p" in
        /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/media|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var)
            return 1
            ;;
    esac
}

hm_project_add() {
    hm_begin_mutation
    hm_install_dependencies
    hm_ensure_user

    local path="${1:-}"
    [[ -n "$path" ]] || hm_die "Usage: hermes-manager project-add /absolute/path"

    path="$(readlink -f "$path")"
    hm_validate_project_path "$path" || \
        hm_die "Unsafe or invalid project root: $path"

    if ! grep -Fxq "$path" "$HERMES_PROJECTS"; then
        printf '%s\n' "$path" >>"$HERMES_PROJECTS"
        sort -u -o "$HERMES_PROJECTS" "$HERMES_PROJECTS"
    fi

    setfacl -R -m "u:${HERMES_USER}:rwX" "$path"
    find "$path" -type d -exec setfacl -m "d:u:${HERMES_USER}:rwX" {} +

    hm_write_service

    if systemctl is-active --quiet "$HERMES_SERVICE"; then
        hm_restart_dashboard
    fi

    hm_info "Hermes project access granted: $path"
}

hm_project_remove() {
    hm_begin_mutation
    hm_ensure_user

    local path="${1:-}"
    [[ -n "$path" ]] || hm_die "Usage: hermes-manager project-remove /absolute/path"

    path="$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")"

    if [[ -f "$HERMES_PROJECTS" ]]; then
        grep -Fxv "$path" "$HERMES_PROJECTS" >"${HERMES_PROJECTS}.tmp" || true
        mv -f "${HERMES_PROJECTS}.tmp" "$HERMES_PROJECTS"
        chown root:root "$HERMES_PROJECTS"
        chmod 0644 "$HERMES_PROJECTS"
    fi

    if [[ -d "$path" ]]; then
        setfacl -R -x "u:${HERMES_USER}" "$path" 2>/dev/null || true
        find "$path" -type d -exec setfacl -x "d:u:${HERMES_USER}" {} + 2>/dev/null || true
    fi

    hm_write_service
    if systemctl is-active --quiet "$HERMES_SERVICE"; then
        hm_restart_dashboard
    fi

    hm_info "Hermes project authorization removed: $path"
}

hm_projects() {
    echo "=== Hermes projects ==="
    hm_projects_raw || true
}

hm_project_check() {
    local path="${1:-}"
    [[ -n "$path" ]] || hm_die "Usage: hermes-manager project-check /absolute/path"

    path="$(readlink -f "$path")"
    [[ -d "$path" ]] || hm_die "Project path does not exist."

    echo "Path: $path"
    grep -Fxq "$path" "$HERMES_PROJECTS" && echo "Registered: yes" || echo "Registered: no"

    if hm_run_as_user test -r "$path" && hm_run_as_user test -w "$path"; then
        echo "Hermes access: read/write"
    else
        echo "Hermes access: FAILED"
        return 1
    fi
}

hm_write_service() {
    hm_ensure_user

    local tmp
    tmp="$(mktemp /tmp/hermes-dashboard.service.XXXXXX)"

    cat >"$tmp" <<EOF
[Unit]
Description=Nous Research Hermes Agent Web Dashboard
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=${HERMES_USER}
Group=${HERMES_GROUP}
WorkingDirectory=${HERMES_HOME_ROOT}

Environment=HOME=${HERMES_HOME_ROOT}
Environment=HERMES_HOME=${HERMES_HOME}
Environment=VIRTUAL_ENV=${HERMES_VENV}
Environment=XDG_DATA_HOME=${HERMES_LOCAL_SHARE}
Environment=XDG_CACHE_HOME=${HERMES_CACHE_DIR}
Environment=XDG_CONFIG_HOME=${HERMES_CONFIG_HOME}
Environment=UV_PYTHON_INSTALL_DIR=${HERMES_UV_PYTHON_DIR}
Environment=UV_PYTHON_BIN_DIR=${HERMES_UV_PYTHON_BIN_DIR}
Environment=UV_NO_CONFIG=1
Environment=PATH=${HERMES_VENV_BIN}:${HERMES_MANAGED_BIN}:${HERMES_LOCAL_BIN}:${HERMES_HOME}/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=${HERMES_LAUNCHER} dashboard --host ${HERMES_DASHBOARD_HOST} --port ${HERMES_DASHBOARD_PORT} --no-open

Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=20s
KillSignal=SIGTERM

UMask=0027
LimitNOFILE=65535
TasksMax=8192

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

ReadWritePaths=${HERMES_HOME_ROOT}
EOF

    local p
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        printf 'ReadWritePaths=%s\n' "$p" >>"$tmp"
    done < <(hm_projects_raw)

    cat >>"$tmp" <<'EOF'

[Install]
WantedBy=multi-user.target
EOF

    install -o root -g root -m 0644 "$tmp" "$HERMES_SERVICE_FILE"
    rm -f "$tmp"

    systemctl daemon-reload
}

hm_wait_dashboard() {
    local i
    for i in $(seq 1 60); do
        if curl -fsS \
            --connect-timeout 2 \
            --max-time 5 \
            "${HERMES_DASHBOARD_URL}/api/status" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

hm_start_dashboard() {
    hm_require_root
    systemctl enable --now "$HERMES_SERVICE"
    hm_wait_dashboard || {
        systemctl --no-pager --full status "$HERMES_SERVICE" >&2 || true
        journalctl -u "$HERMES_SERVICE" -n 100 --no-pager >&2 || true
        hm_die "Hermes dashboard did not become healthy."
    }
}

hm_stop_dashboard() {
    hm_require_root
    systemctl stop "$HERMES_SERVICE"
}

hm_restart_dashboard() {
    hm_require_root
    systemctl restart "$HERMES_SERVICE"
    hm_wait_dashboard || {
        journalctl -u "$HERMES_SERVICE" -n 100 --no-pager >&2 || true
        hm_die "Hermes dashboard restart failed."
    }
}

hm_dashboard_status() {
    hm_require_root

    echo "=== Hermes dashboard ==="
    systemctl --no-pager --full status "$HERMES_SERVICE" 2>/dev/null | \
        sed -n '1,28p' || true

    echo
    echo "Local URL: $HERMES_DASHBOARD_URL"

    if curl -fsS --connect-timeout 2 --max-time 5 \
        "${HERMES_DASHBOARD_URL}/api/status" >/dev/null 2>&1; then
        echo "Health: OK"
        curl -fsS "${HERMES_DASHBOARD_URL}/api/status" | jq . 2>/dev/null || true
    else
        echo "Health: NOT AVAILABLE"
    fi
}

hm_dashboard_logs() {
    hm_require_root
    local lines="${1:-$HERMES_LOG_LINES}"
    [[ "$lines" =~ ^[1-9][0-9]*$ ]] || hm_die "LINES must be a positive integer."
    (( lines <= 5000 )) || hm_die "LINES capped at 5000."
    journalctl -u "$HERMES_SERVICE" -n "$lines" --no-pager
}

hm_dashboard_follow() {
    hm_require_root
    journalctl -u "$HERMES_SERVICE" -f
}

hm_install() {
    hm_begin_mutation

    hm_log "Installing Hermes CLI + Web Dashboard"
    hm_install_dependencies
    hm_ensure_user
    hm_run_official_installer
    hm_install_dashboard_extras
    hm_write_cli_wrapper
    hm_write_service

    systemctl enable --now "$HERMES_SERVICE"
    hm_wait_dashboard || {
        journalctl -u "$HERMES_SERVICE" -n 120 --no-pager >&2 || true
        hm_die "Dashboard failed after installation."
    }

    hm_verify

    echo
    echo "Hermes CLI:"
    echo "  hermes"
    echo
    echo "Hermes Dashboard:"
    echo "  ${HERMES_DASHBOARD_URL}"
    echo
    echo "Provider setup:"
    echo "  sudo hermes-manager setup-portal"
}

hm_repair() {
    hm_begin_mutation

    hm_log "Repairing Hermes"
    hm_install_dependencies
    hm_ensure_user

    # Recover cleanly from an interrupted v1.0.0 install, including root-owned
    # ~/.local parents that blocked uv-managed Python provisioning.
    chown -R "$HERMES_USER":"$HERMES_GROUP" "$HERMES_HOME_ROOT"

    if [[ ! -x "$HERMES_LAUNCHER" || ! -d "$HERMES_CODE" ]]; then
        hm_warn "Hermes runtime is incomplete; rerunning official installer."
        hm_run_official_installer
    fi

    chown -R "$HERMES_USER":"$HERMES_GROUP" "$HERMES_HOME_ROOT"

    hm_install_dashboard_extras
    hm_write_cli_wrapper
    hm_write_service

    local p
    while IFS= read -r p; do
        [[ -n "$p" && -d "$p" ]] || continue
        setfacl -R -m "u:${HERMES_USER}:rwX" "$p"
        find "$p" -type d -exec setfacl -m "d:u:${HERMES_USER}:rwX" {} +
    done < <(hm_projects_raw)

    systemctl enable --now "$HERMES_SERVICE"
    hm_restart_dashboard
    hm_verify
}

hm_update() {
    hm_begin_mutation
    hm_install_dependencies
    hm_ensure_user

    [[ -x "$HERMES_LAUNCHER" ]] || hm_die "Hermes is not installed."

    hm_backup >/dev/null

    local was_active="no"
    if systemctl is-active --quiet "$HERMES_SERVICE"; then
        was_active="yes"
        systemctl stop "$HERMES_SERVICE"
    fi

    hm_log "Updating Hermes through its official updater"
    hm_hermes update --backup

    hm_install_dashboard_extras
    hm_write_cli_wrapper
    hm_write_service

    if [[ "$was_active" == "yes" ]]; then
        systemctl start "$HERMES_SERVICE"
        hm_wait_dashboard || hm_die "Dashboard failed after Hermes update."
    fi

    hm_verify
}

hm_check_update() {
    hm_require_root
    hm_ensure_user
    hm_hermes update --check
}

hm_reinstall() {
    hm_begin_mutation
    hm_install_dependencies
    hm_ensure_user

    hm_backup >/dev/null

    systemctl stop "$HERMES_SERVICE" 2>/dev/null || true

    hm_run_official_installer
    hm_install_dashboard_extras
    hm_write_cli_wrapper
    hm_write_service

    systemctl enable --now "$HERMES_SERVICE"
    hm_wait_dashboard || hm_die "Dashboard failed after reinstall."
    hm_verify
}

hm_backup() {
    hm_require_root
    hm_ensure_user

    local out="${1:-/root/hermes-agent-backup-$(date -u +%Y%m%dT%H%M%SZ).tar.gz}"
    [[ "$out" == /* ]] || hm_die "Backup path must be absolute."

    local items=()
    [[ -d "$HERMES_HOME" ]] && items+=("${HERMES_HOME#/}")
    [[ -f "$HERMES_PROJECTS" ]] && items+=("${HERMES_PROJECTS#/}")

    tar --acls --xattrs --numeric-owner \
        -C / \
        -czf "$out" \
        "${items[@]}"

    chown root:root "$out"
    chmod 0600 "$out"

    hm_info "Backup created: $out"
    hm_warn "Backup can contain API keys, OAuth credentials, memories, sessions and project metadata."
}

hm_delete() {
    hm_begin_mutation

    systemctl disable --now "$HERMES_SERVICE" 2>/dev/null || true
    rm -f "$HERMES_SERVICE_FILE" "$HERMES_WRAPPER"
    systemctl daemon-reload

    hm_info "Hermes service/wrapper removed."
    hm_info "Preserved data: $HERMES_HOME_ROOT"
}

hm_purge() {
    hm_begin_mutation

    cat <<EOF
DESTRUCTIVE OPERATION

This will permanently delete:
  ${HERMES_HOME_ROOT}
  ${HERMES_CONFIG_DIR}
  ${HERMES_SERVICE_FILE}
  ${HERMES_WRAPPER}

Registered project directories themselves will NOT be deleted.
EOF

    local answer=""
    read -r -p "Type PURGE-HERMES-AGENT to continue: " answer
    [[ "$answer" == "PURGE-HERMES-AGENT" ]] || hm_die "Purge cancelled."

    systemctl disable --now "$HERMES_SERVICE" 2>/dev/null || true

    local p
    while IFS= read -r p; do
        [[ -n "$p" && -d "$p" ]] || continue
        setfacl -R -x "u:${HERMES_USER}" "$p" 2>/dev/null || true
        find "$p" -type d -exec setfacl -x "d:u:${HERMES_USER}" {} + 2>/dev/null || true
    done < <(hm_projects_raw)

    rm -f "$HERMES_SERVICE_FILE" "$HERMES_WRAPPER"
    rm -rf "$HERMES_CONFIG_DIR" "$HERMES_HOME_ROOT"
    userdel "$HERMES_USER" 2>/dev/null || true
    systemctl daemon-reload

    hm_info "Hermes Agent purged."
}

hm_setup() {
    hm_require_root
    hm_ensure_user
    hm_hermes setup
}

hm_setup_portal() {
    hm_require_root
    hm_ensure_user
    hm_hermes setup --portal
}

hm_cli() {
    hm_require_root
    hm_ensure_user
    shift || true
    hm_hermes "$@"
}

hm_model() {
    hm_require_root
    hm_ensure_user
    hm_hermes model
}

hm_tools() {
    hm_require_root
    hm_ensure_user
    hm_hermes tools
}

hm_plugins() {
    hm_require_root
    hm_ensure_user
    hm_hermes plugins "$@"
}

hm_mcp() {
    hm_require_root
    hm_ensure_user
    hm_hermes mcp "$@"
}

hm_sessions() {
    hm_require_root
    hm_ensure_user
    hm_hermes sessions "$@"
}

