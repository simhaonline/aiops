# Server-only API authentication. Never expose these values to the browser.
AIOPS_DASHBOARD_TOKEN=replace-with-a-long-random-token
AIOPS_TENANT_ID=00000000-0000-4000-8000-000000000001
AIOPS_DASHBOARD_ROLE=admin
AIOPS_API_PORT=11081

# PostgreSQL is required for private CRUD APIs. Apply database migrations first.
AIOPS_DATABASE_URL=postgresql://aiops_api:change-me@127.0.0.1:5432/aiops
AIOPS_DATABASE_SSL=disable
AIOPS_DATABASE_POOL_MAX=10

# Worker process. Run `npm run worker -w @aiops/api` separately from the API.
AIOPS_WORKER_ID=local-worker
AIOPS_WORKER_POLL_MS=1000
AIOPS_MAX_UPLOAD_BYTES=26214400

# S3-compatible storage (MinIO locally; use S3/R2 endpoint in production).
AIOPS_STORAGE_MODE=s3
AIOPS_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59100
AIOPS_OBJECT_STORAGE_REGION=us-east-1
AIOPS_OBJECT_STORAGE_BUCKET=simha-dev
AIOPS_OBJECT_STORAGE_FORCE_PATH_STYLE=true
AIOPS_OBJECT_STORAGE_ACCESS_KEY=simha_dev
AIOPS_OBJECT_STORAGE_SECRET_KEY=simha_dev_password
AIOPS_SIGNED_URL_SECONDS=300

# Explicit local adapters for tests only; never enable these silently in prod.
AIOPS_EMBEDDINGS_DEV=false
AIOPS_MEDIA_DEV=false
AIOPS_EMBEDDING_MODEL=text-embedding-3-small
AIOPS_EMBEDDING_DIMENSIONS=1536

# Optional provider/job configuration. Missing credentials produce explicit
# setup states; they are not replaced with fake completions.
AIOPS_OBJECT_STORAGE_ENDPOINT=
AIOPS_OBJECT_STORAGE_BUCKET=
AIOPS_OBJECT_STORAGE_ACCESS_KEY=
AIOPS_OBJECT_STORAGE_SECRET_KEY=
Q_AI_GATEWAY_URL=http://127.0.0.1:11434/v1
Q_AI_CHAT_MODEL=qwen3.5:cloud
